# ビルド派生物 (= make で再生成されるため git track しない)
build/
tmp/

# ROM バイナリは原則 git track しない
*.rom
*.bin

# 例外: 配布用に同梱する ROM イメージのみ track する。
!roms/
roms/*
!roms/boot_bas.rom
!roms/boot_dos.rom
!roms/subsys_c.rom
!roms/initiate.rom
!roms/initbase.rom
!roms/initav1.rom
!roms/initex.rom
!roms/subsys_a.rom
!roms/subsys_b.rom
!roms/subsyscg.rom
!roms/extsub.rom
!roms/7tbasic3.rom
!roms/kanji.rom
!roms/kanji2.rom
!roms/dicrom.rom

# Python キャッシュ
__pycache__/
*.pyc

# Prerequisites／オブジェクト／リンカ出力
*.d
*.o
*.obj
*.elf
*.map
*.lst

# OS／エディタ生成ファイル
.DS_Store
Thumbs.db
*.swp
*~
._*
