;==============================================================================
; MID$ 文 — 文字列の部分置換
;
;   書式:
;       MID$(<文字列変数>,<開始位置>[,<長さ>]) = <文字列式>
;
;   開始位置 (1 起点) から右辺の内容を上書きする。**置換で文字列の長さは
;   変わらない**。実際に書き換わるのは
;       min(<長さ>, 右辺の長さ, 開始位置から末尾までの残り)
;   バイトで、右辺が長すぎれば切り捨て、短ければその分しか書かない。
;   <長さ> を省いたときは右辺の長さがそのまま指定長になる。
;   開始位置が 1..文字列長 の外 (0 / 負 / 長さ超過) は Illegal Function Call。
;   <長さ> が 0..255 の外 (負 / 256 以上) も Illegal Function Call。
;   左辺が文字列変数でない・右辺が文字列でないときは Type Mismatch。
;
;   実体の所有 (仕組みを使う)
;     文字列変数の実体はプログラム本文中の定数を指していることがある。そのまま
;     書き換えるとプログラム本文そのものを壊すので、置換の前に文字列領域へ複写
;     して所有させる。所有の確保は詰め直しを起こし得るため、右辺を評価する前に
;     済ませる (詰め直しは恒久ブロックを動かすので、右辺の実体を先に確定させて
;     いると危ない)。
;
;   本片は空きプールに置く。参照はラベル経由のみで位置依存はない。
;   同じ区画の余白へ、文字列代入の入口 str_asg_mark も相乗りさせてある。
;==============================================================================
;------------------------------------------------------------------------------
; str_asg_mark — 文字列変数への格納の入口。
;   上書きで捨てられる旧実体が文字列領域の中に在るなら、それはごみになる。
;   文の切れ目の詰め直しに拾わせるため、ここで印を立ててから本体へ落ちる。
;   印を str_own の中に置くと、空文字列や本文中の定数の代入 (str_own を
;     通らない経路) で捨てた実体が回収されないまま残る。
;   入力: U = 記述子。破壊: D。
;   (str_assign 本体の在る区画には空きが無いため、本プールへ置く)
;------------------------------------------------------------------------------
str_asg_mark:
                LDD     1,U
                CMPD    FRETOP
                BLS     sam_go          ; 領域の外 (本文中の定数など) → ごみは出ない
                INC     str_gcflg
sam_go:
                JMP     str_assign


                ; INPUT 文 (関数トークン $FF $A6 が文位置に出現)。
                ; 書式: INPUT [;] ["プロンプト" {;|,}] 変数 [,変数...]
                ;   "プロンプト"; → プロンプト+"? " / "プロンプト", → プロンプトのみ /
                ;   プロンプト無し → "? " (参考書籍)。
                ; 第2バイトを読み捨てるだけにすると INPUT 行が丸ごと飛ばされる。
                ; INPUT と MID$ 文の判定は当区間に空きが無いため
                ; 別の区画の空きプール (7t_midstmt.inc) へ出してある。
;------------------------------------------------------------------------------
; mid_chk — 文頭の関数トークン第 2 バイトのうち、INPUT と MID$ を判定する。
;   (fn_stmt_dispatch の末尾から長い分岐で入る。呼出側の区画に空きが無いため、
;    判定そのものを本プールへ出してある)
;   入力: A = 第 2 バイト, X = 第 2 バイト直後
;   出力: C=0 … 文としての意味を持たない (呼出側が読み飛ばす)
;------------------------------------------------------------------------------
mid_chk:
                CMPA    #TOK2_INPUT     ; INPUT 文?
                LBEQ    fsd_input
                CMPA    #TOK2_MID       ; MID$ 文?
                BEQ     mid_stmt
                CMPA    #TOK2_PEN       ; PEN 文?
                BEQ     pen_dev60
                ANDCC   #$FE            ; C=0 (代入形でない)
                RTS

;------------------------------------------------------------------------------
; pen_dev60 — PEN の文形・関数形の共通出口。
;   本機にはタッチペン装置が無いので、文形も関数形も
;   Error 60 (Device Unavailable) とする (動作観察)。関数形は fn_jt の
;   PEN 番からも直接ここへ入る。
;------------------------------------------------------------------------------
pen_dev60:
                LDB     #60             ; Device Unavailable
                JMP     impl_error_handler

;------------------------------------------------------------------------------
; mid_stmt — MID$ 文の本体。
;   入力: X = 第 2 バイト直後 ('(' の位置)
;   出力: C=1 (文として処理済), X = 文の直後
;------------------------------------------------------------------------------
mid_stmt:
                JSR     skip_sp_lparen
                LBNE    mid_syn
                LEAX    1,X
                JSR     impl_get_var_ref        ; U = 記述子, VARTYP, X = 名前直後
                LDA     VARTYP
                CMPA    #VTYPE_STR
                LBNE    err_tmm
                ; 代入先のアドレスは CPU スタックでなく let_tgt へ置く (同じ
                ;   理由)。以降の式評価が未定義変数を作るとスカラ域が伸びて配列
                ;   ブロックが丸ごと動くが、let_tgt なら vars_make_room が移動量
                ;   ぶん追従させてくれる。
                STU     let_tgt
                ; --- 実体を所有させる (右辺の評価より前に済ませる) ---
                LDD     1,U                     ; 現在の実体先頭
                CMPD    FRETOP
                BHI     mid_own_ok              ; 既に文字列領域の中 = 所有済
                STD     STRPTR
                LDA     ,U                      ; 長さ
                STA     STRLEN
                BEQ     mid_own_ok              ; 空文字列は実体を持たない
                JSR     str_own                 ; D = 確保して複写した実体
                LDU     let_tgt
                STD     1,U
mid_own_ok:
                JSR     skip_sp_comma
                BNE    mid_syn
                LEAX    1,X
                ; 開始位置・指定長の値域 (0..255 / 最近接丸め) は、MID$ 関数や
                ;   LEFT$ / RIGHT$ / STRING$ / SPACE$ と同じ規則である。判定を
                ;   ここへ書き写すと片方だけ直して食い違う。共通ヘルパ
                ;   eval_to_int_255 を呼び、規則の持ち主を 1 箇所に保つ。
                JSR     eval_to_int_255         ; B = 開始位置 (範囲外は ERR 5)
                PSHS    B                       ; 0,S = 開始位置
                LDB     #255                    ; 長さ省略時 = 右辺長で決まる
                JSR     skip_sp_comma
                BNE     mid_len_ok
                LEAX    1,X
                JSR     eval_to_int_255         ; B = 指定長 (範囲外は ERR 5)
mid_len_ok:
                PSHS    B                       ; 0,S = 指定長 / 1,S = 開始位置
                JSR     skip_sp_x
                CMPA    #')'
                BNE    mid_syn
                JSR     skip1_sp_x              ; 空白読み飛ばし (1 進めてから)
                CMPA    #TOK_EQ                 ; '=' はトークナイザが変換済み
                BEQ     mid_eq
                CMPA    #'='                    ; 生 '=' も受ける (ASCII 由来本文)
                BNE    mid_syn
mid_eq:
                LEAX    1,X
                JSR     eval_chk_str            ; 右辺 → STRPTR/STRLEN (Z=1 で文字列)
                BNE     err_tm
                ; --- 置換バイト数 n = min(指定長, 右辺長, 残り) を求める ---
                LDU     let_tgt
                LDA     ,U                      ; A = 文字列長
                LDB     1,S                     ; B = 開始位置 (1 起点)
                BEQ     mid_fc                 ; 0 は範囲外
                PSHS    A
                CMPB    ,S+
                BHI     mid_fc                 ; 開始位置 > 文字列長 → 範囲外
                PSHS    B
                SUBA    ,S+                     ; A = 文字列長 - 開始位置
                INCA                            ; A = 残り
                CMPA    ,S
                BLS     mid_min2
                LDA     ,S                      ; 指定長のほうが小さい
mid_min2:
                CMPA    STRLEN
                BLS     mid_go
                LDA     STRLEN                  ; 右辺のほうが短い
mid_go:
                TSTA
                BEQ     mid_fin                 ; 0 バイト → 何もしない
                STA     ,S                      ; 指定長スロットを実置換長 n に
                PSHS    X                       ; 本文ポインタ退避
                ; 0,S:1,S = 本文ポインタ / 2,S = n / 3,S = 開始位置
                ; 複写は末尾から行う。右辺が代入先と同じ実体を指すことがあり
                ;   (MID$(A$,2,2)=A$)、先頭から写すと書いたばかりのバイトを
                ;   読み直して結果が崩れる。書込先は必ず読出元と同じか後ろなので
                ;   後ろから写せば重なりに強い。
                LDU     let_tgt
                LDX     1,U                     ; X = 実体先頭
                LDB     3,S                     ; 開始位置
                DECB                            ; = 書込先オフセット
                ADDB    2,S                     ; + n (合計は文字列長以下)
                ABX                             ; X = 書込先の末尾 + 1
                TFR     X,U
                LDX     STRPTR
                LDB     2,S                     ; B = n
                ABX                             ; X = 右辺の末尾 + 1
mid_cp:
                LDA     ,-X
                STA     ,-U
                DECB
                BNE     mid_cp
                PULS    X                       ; 本文ポインタ復元
mid_fin:
                LEAS    2,S                     ; 指定長 / 開始位置 を捨てる
                ORCC    #$01                    ; C=1 (文として処理済)
                RTS
                ; 誤り出口 (impl_error_handler が S を巻き戻すので後始末は不要)
mid_syn:
                JMP     errc_2                  ; Syntax Error
mid_fc:
                JMP     errc_5                  ; Illegal Function Call

;------------------------------------------------------------------------------
; swap_bytes — U と X が指す B バイトを入れ換える (SWAP 文の交換本体)。
;   入力: U / X = 入れ換える記録域, B = バイト数 (1 以上)。
;   破壊: A, B, X, U。
;   (呼出元 impl_swap の区画に残量が無いため本プールへ置く。参照はラベル経由
;    のみで位置依存はない)
;------------------------------------------------------------------------------
swap_bytes:
                PSHS    B                       ; 残りバイト数
swb_lp:
                LDA     ,U
                LDB     ,X
                STB     ,U+
                STA     ,X+
                DEC     ,S
                BNE     swb_lp
                PULS    B,PC
