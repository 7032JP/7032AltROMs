;==============================================================================
; DATA / INPUT の項目まわりの判定 (区画の空きの都合でここへ置く。参照はラベル
; 経由のみで位置依存はない)
;==============================================================================

;------------------------------------------------------------------------------
; irv_num — 数値の項目を取り出し、項目として妥当かを確かめる。
;   数値の項目は「値が 1 文字も無い」「数として読んだ後に字が残る」のどちらでも
;   誤りである (参考書籍)。数値解析器が
;   止まった位置をそのまま採ると、値の書き忘れ (1,,3) が 0 に、打ち間違い
;   (12X) が 12 になり、誤りが表に出ないまま処理が進む。
;   入力: X = 項目の先頭 (先行空白は呼出側が読み飛ばし済)
;   出力: FAC1 = 値, X = 項目の直後 (後続の空白も読み飛ばす)
;         C=0 … 項目として正しい / C=1 … 数値として読めない項目
;   ※ 判定は「解析器が 1 文字でも進んだか」と「残りが区切りか終端か」の 2 つ。
;      区切りはコンマと inp_dlm2 (':')、終端は行末 $00 である。
;------------------------------------------------------------------------------
irv_num:
                PSHS    X               ; 項目の先頭を控える
                JSR     impl_parse_num  ; 数値 (X 前進, FAC1 セット)
                JSR     skip_sp_x       ; 値の直後の空白を読み飛ばす (A = その字)
                CMPX    ,S++            ; 控えと同じ = 1 文字も進んでいない
                BEQ     irv_bad         ;   → 空の項目
                TSTA                    ; A は skip_sp_x が返した現在の字
                BEQ     irv_ok          ; 行末
                CMPA    #','
                BEQ     irv_ok
                CMPA    inp_dlm2
                BNE     irv_bad         ; 数の後ろに字が残った
irv_ok:
                ANDCC   #$FE            ; C=0 (正しい項目)
                RTS
irv_bad:
                ORCC    #$01            ; C=1 (数値として読めない項目)
                RTS


                ; 値の直後の空白を読み飛ばし C=0 で戻る (ここへ展開)
;------------------------------------------------------------------------------
; irv_okx — 文字列の項目の共通尾部。値の直後の空白を読み飛ばし C=0 で戻る。
;   文字列の項目は空でも正しい (長さ 0 の文字列) ので判定は要らない。
;------------------------------------------------------------------------------
irv_okx:
                JSR     skip_sp_x
                BRA     irv_ok

;------------------------------------------------------------------------------
; impl_data — 実行時に DATA 文を読み飛ばす。
;   DATA 文は行末だけでなく文の区切り ':' でも終わるので、同じ行に続けて書いた
;   文は実行される (参考書籍)。REM と同じ「行末までの
;   読み飛ばし」を共用すると、DATA を行頭に置いて後ろに処理を続けて書いた行の
;   後半が丸ごと実行されなくなる。
;   引用符の中の ':' は値の一部なので区切りには数えない。
;   出力: X = 行末の $00 か、区切りの ':' そのものを指す (':' の読み飛ばしは
;         実行ループが行う規約なのでここでは消費しない)。
;------------------------------------------------------------------------------
impl_data:
                LDA     ,X
                BEQ     idat_ret        ; 行末
                CMPA    #':'
                BEQ     idat_ret        ; 文の区切り
                LEAX    1,X
                CMPA    #'"'
                BNE     impl_data
idat_q:
                LDA     ,X              ; 引用符の中は区切りを見ない
                BEQ     idat_ret        ; 閉じ忘れ → 行末扱い
                LEAX    1,X
                CMPA    #'"'
                BNE     idat_q
                BRA     impl_data
idat_ret:
                RTS

;------------------------------------------------------------------------------
; tdd_lp — 字句解析で DATA 文の値を生のまま写す走査 (7t_tokenizer.inc から。
;   当該区間に余地が無いため本プールへ置く。参照はラベル経由のみで位置依存なし)。
;   REM / ' の後は行末まで生で写すが、DATA は文の区切り ':' で終わり、同じ行に
;   別の文が続けられる。よって ':' で写しを打ち切り、以降は通常どおり予約語へ
;   直す (参考書籍)。直さないと続く文が実行できない。
;   引用符の中の ':' は値の一部なので区切りには数えない。
;   入出力: X = 読み位置, U = 書き込み位置 (どちらも tok_lp の規約のまま)
;------------------------------------------------------------------------------
tdd_lp:
                PSHS    U,X             ; 0,S = 原文の写し始め (X), 2,S = 作業列の写し先 (U)
tdd_cp:
                LDA     ,X
                BEQ     tdd_end         ; 行末
                CMPA    #':'
                BEQ     tdd_end         ; 文の区切り → 以降は通常の字句解析へ
                STA     ,U+
                LEAX    1,X
                CMPA    #'"'
                BNE     tdd_cp
tdd_q:
                LDA     ,X              ; 引用符の中の ':' は値の一部
                BEQ     tdd_end         ; 閉じ忘れ → 行末扱い
                STA     ,U+
                LEAX    1,X
                CMPA    #'"'
                BNE     tdd_q
                BRA     tdd_cp
tdd_end:
                ; READ の文字列の値を原文へ張り替えるための対応付け (ird2_share)。
                ;   DATA の値の写しは原文と 1 対 1 なので、dat_tgt (作業列上の位置) が
                ;   この DATA 文の写し [写し先, U) に入るなら、写し始めから同じ距離だけ
                ;   進んだ原文の位置を dat_src に記す。入らなければ何もしない。
                ;   1 バイトごとの照合は要らず、DATA 文 1 つにつきここで 1 回だけ計算する。
                TFR     U,D
                SUBD    2,S             ; D = 写した長さ
                PSHS    D               ; 0,S = 長さ, 2,S = 原文の写し始め, 4,S = 作業列の写し先
                LDD     dat_tgt
                SUBD    4,S             ; D = 写し先からの距離
                BCS     tdd_x           ; 写し先より手前
                CMPD    ,S
                BHS     tdd_x           ; この DATA 文の写しより後ろ
                ADDD    2,S             ; 原文の写し始め + 距離
                STD     dat_src
tdd_x:
                LEAS    6,S
tdd_ret:
                JMP     tok_lp

;------------------------------------------------------------------------------
; tkp_raw — 注記 (REM / ') の後を行末まで生で写す走査 (7t_tokenizer.inc から。
;   当該区間に余地が無いため本プールへ置く。参照はラベル経由のみで位置依存なし)。
;   入出力: X = 読み位置, U = 書き込み位置 (どちらも tok_lp の規約のまま)
;------------------------------------------------------------------------------
tkp_raw:
                LDA     ,X
                BEQ     tdd_ret         ; 行末
                STA     ,U+
                LEAX    1,X
                BRA     tkp_raw

;------------------------------------------------------------------------------
; ird2_share — READ で取り出した文字列の値を、作業列の写しから格納本文 (原文) の
;   位置へ張り替える (impl_read_data の尾部から。当該区間に余地が無いため本プールへ)。
;   文字列変数への格納 (str_assign) は、値が本文 (TXTTAB..VARTAB) の中に在るときは
;   複写せずに本文を指すだけで済ませる。READ の値は作業列 (行変換の写し) に在り、
;   そのままでは READ のたびに文字列領域へ複写され、CLEAR で取った文字領域を
;   DATA の値の数だけ消費する。本文の値を指すだけなら文字領域は減らない。
;   本文は変数より長生きする (行の追加・置換・削除、RENUM、LOAD は全変数を消す)。
;   MID$ 文は書き換える前に所有 (複写) するので原文は壊れない。
;   入力: STRPTR/STRLEN = 作業列上の値 (長さ非 0)。dat_src = 直前の行変換が
;         dat_tgt に対して記した原文の位置 (0 = 未確定)。
;         未確定なら値の位置そのものを dat_tgt に置いて DATA 行を変換し直し、
;         対応付けを得る (同じ行が載っていても変換し直す。変換は決定的なので
;         作業列の内容は変わらない)。
;   出力: STRPTR = 原文の位置。破壊: D, X。
;------------------------------------------------------------------------------
ird2_share:
                LDD     dat_src
                BNE     irs_apply       ; 継続読みで対応付け済み
                LDD     STRPTR
                STD     dat_tgt
                JSR     clr_execrec
                LDX     DATLINE
                JSR     exec_load_rec   ; STRLEN/FACTYPE は保たれる
                LDD     dat_src
                BEQ     irs_ret         ; 対応付けが無い → 複写のまま (安全側)
irs_apply:
                SUBD    dat_tgt         ; 原文と作業列の位置の差
                ADDD    STRPTR
                STD     STRPTR
irs_ret:
                RTS

