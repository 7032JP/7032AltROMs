;==============================================================================
; 文字列領域 — 一時領域の確保
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立しているため、文字列領域の
;   実装は複数の空きプールへ分けて配置してある。参照は全てラベル経由で位置
;   依存はない。
;==============================================================================
;------------------------------------------------------------------------------
; str_tmp_alloc — 一時領域を B バイト確保して X (先頭) に返す。
;   入力: B = 長さ (0-255)。出力: X = 先頭。破壊: D。
;   足りなければ Out Of String Space (復帰しない)。
;------------------------------------------------------------------------------
str_tmp_alloc:
                LDX     TMPPTR
                LEAX    1,X             ; 先頭 = 直前の末尾 + 1
                CLRA                    ; D = 長さ
                ADDD    TMPPTR          ; D = 新しい末尾
                CMPD    FRETOP
                BHI     str_oos         ; 恒久ブロックに食い込む
                STD     TMPPTR
                RTS
str_oos:
                LDB     #14             ; Out Of String Space
                JMP     impl_error_handler
