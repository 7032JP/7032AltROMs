; PRINT USING — 指数形式 '^^^^' の書式検出
;   出典: 参考書籍 PRINT USING (指数形式は '^' 4 個で指定)。
;   数値書式の桁指定・小数指定の直後、後置符号より手前で判定する
;   (動作観察: "##.##+^^^^" は指数化されず '+' が後置符号になる)。
;   '^' が 4 個そろわなければ指数形式でなく '^' はリテラルのまま
;   (動作観察: "##.##^^^" は指数化されない / 5 個目以降もリテラル)。
;
;   入力: A=現在文字, U=書式位置, B=書式残り (>0), S=フレーム基底+2 (JSR 復帰アドレス)
;   出力: 一致時 = UF_EXPF=1 / U,B を 4 進める / A=次の文字 (使い切りなら 0)
;         不一致時 = A,U,B とも不変
;   本片は空きプール。
;==============================================================================
ins_expchk:
        CMPA    #'^'
        BNE     iek_r
        CMPB    #4
        BLO     iek_r           ; 4 個に足りない → リテラル
        LDY     ,U              ; A を壊さずに 2 文字ずつ照合する
        CMPY    #$5E5E          ; '^^'
        BNE     iek_r
        LDY     2,U
        CMPY    #$5E5E
        BNE     iek_r
        INC     UF_EXPF+2,S     ; +2 = JSR 復帰アドレスぶん
        LEAU    4,U
        SUBB    #4
        LDA     ,U
        TSTB
        BNE     iek_r
        CLRA                    ; 使い切り → 後置符号判定に掛からない値へ
iek_r:
        RTS
