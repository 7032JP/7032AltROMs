;==============================================================================
; 文字列領域 — 一時領域への複写
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立しているため、文字列領域の
;   実装は複数の空きプールへ分けて配置してある。参照は全てラベル経由で位置
;   依存はない。
;==============================================================================
;------------------------------------------------------------------------------
; str_to_tmp — STRPTR/STRLEN の文字列を一時領域へ複写し STRPTR を差し替える。
;   文字列を返す関数の共通尾部 (fret_str) から呼ぶ。結果を一時領域へ置くので、
;   同じ関数を 2 回使っても先の結果が後の結果に書き潰されない。
;   破壊: D。X/U は保存する。
;------------------------------------------------------------------------------
str_to_tmp:
                LDB     STRLEN
                BEQ     stt_done        ; 空文字列は実体を持たない
                PSHS    X
                JSR     str_tmp_alloc   ; X = 複写先
                JSR     str_cpy_in      ; STRPTR から STRLEN 複写 (X 保存)
                STX     STRPTR
                PULS    X
stt_done:
                RTS
