; 文字列領域
;
;   ... 配列 ... STREND ..... 空き ..... S(スタック) │ 一時 →    ← 恒久 │
;                                                    STRBOT      FRETOP  MEMTOP
;
;   恒久ブロック : 文字列変数・文字列配列要素が「所有する」実体。FRETOP から
;                  下へ伸ばす。1 個あたり 長さ+2 byte を占める。
;   一時         : 文字列を返す関数と連結の結果。STRBOT から上へ伸ばし、
;                  文の切れ目ごとに TMPPTR を STRBOT へ戻して一括開放する。
;                  代入は必ず恒久側へ複写するので、記述子が一時を指すことは無い。
;   詰め直し     : 恒久側が足りなくなったときだけ str_gc が走る。記述子を
;                  総なめして「まだ処理していない最上位の生きたブロック」を
;                  上へ寄せる操作を繰り返す。後方ポインタは持たないので、
;                  新スカラ作成で配列ブロックが動いても ERASE で配列が消えても
;                  張り直しは要らない。
;
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立していて融通が利かないため、
;   実装は区画ごとの空きプールへ分けて配置してある (7t_strinit / 7t_strclr /
;   7t_strtmp / 7t_strtotmp / 7t_strcpy / 7t_strasg / 7t_strreloc / 7t_strown /
;   7t_strgc / 7t_strgc2)。本片は恒久ブロックの確保だけを持つ。
;   参照は全てラベル経由で位置依存なし。
;==============================================================================

;------------------------------------------------------------------------------
; str_perm_alloc — 恒久ブロックを B バイト確保して X (実体先頭) に返す。
;   足りなければ詰め直しを 1 回行って再試行する。それでも足りなければ
;   Out Of String Space。入力: B = 長さ (1-255)。出力: X。破壊: D。
;   詰め直しは恒久ブロックを動かす。複写元が恒久ブロックのときは呼出側
;     (str_own) が先に一時領域へ退避しておく約束である。
;------------------------------------------------------------------------------
str_perm_alloc:
                PSHS    B
                ; 複写元が一時領域の最上位ブロックなら、確保する前に
                ;   その一時を返しておく (str_tmp_free_top)。返さないと同じ内容が
                ;   一時と恒久に同時に在る瞬間ができ、文字列領域の瞬間使用量が
                ;   長さの 2 倍に膨らみ、FRE("") の勘定では置けるはずの長さで
                ;   Out Of String Space になる)。
                ;   返した領域へ恒久ブロックが重なり得るが、書込先は必ず
                ;   読出元と同じか上位で、str_cpy_in は末尾から写すので崩れない。
                ;   詰め直し (str_gc) は FRETOP より下へは書かないので、
                ;   TMPPTR を下げても複写元が潰される心配はない。
                JSR     str_tmp_free_top ; B = STRLEN で呼ばれる約束 (str_own)
                LDB     ,S
                BSR     spa_try
                BCC     spa_ok
                JSR     str_gc          ; 詰め直してから再試行
                LDB     ,S
                BSR     spa_try
                LBCS    str_oos         ; なお足りない (別の区画に在るので長い分岐)
spa_ok:
                PULS    B,PC            ; 退避した長さを捨てつつ復帰
; spa_try: B = 長さ → 取れたら FRETOP 更新・X=実体先頭・C=0 / 取れなければ C=1
spa_try:
                CLRA
                ADDD    #2              ; D = 長さ + 予備 2 byte
                PSHS    D
                LDD     FRETOP
                SUBD    ,S++            ; D = 新しい FRETOP
                CMPD    TMPPTR
                BLO     spa_fail        ; 一時領域に食い込む
                STD     FRETOP
                TFR     D,X
                LEAX    1,X             ; 実体先頭 = 新 FRETOP + 1
                ANDCC   #$FE            ; C=0
                RTS
spa_fail:
                ORCC    #$01            ; C=1
                RTS
