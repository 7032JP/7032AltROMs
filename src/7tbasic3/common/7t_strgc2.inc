;==============================================================================
; 文字列領域 — 詰め直しの候補選び
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立しているため、文字列領域の
;   実装は複数の空きプールへ分けて配置してある。参照は全てラベル経由で位置
;   依存はない。
;==============================================================================
; gc_try — U = 記述子 [len(1)][ptr(2)]。今回の候補として採れるか調べる。
;   採る条件: 長さ非 0 / 実体が文字列領域内 / 既存候補より上 / gc_dst 以下。
;   破壊: A, B, X。
gc_try:
                LDB     ,U              ; 長さ (記述子 +0)
                BEQ     gc_tr_ret
                LDX     1,U             ; 実体先頭 (記述子 +1)
                CMPX    gc_bptr
                BLS     gc_tr_ret       ; 既存候補より下 (初期値が STRBOT なので
                                        ;   プログラム本文中の定数もここで落ちる)
                CMPX    gc_dst
                BHI     gc_tr_ret       ; 既に詰め終わった側
                STX     gc_bptr
                STU     gc_bdsc
                STB     gc_blen
gc_tr_ret:
                RTS
