;==============================================================================
; 文字列領域 — 文字列変数への格納
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立しているため、文字列領域の
;   実装は複数の空きプールへ分けて配置してある。参照は全てラベル経由で位置
;   依存はない。
;==============================================================================
;------------------------------------------------------------------------------
; str_assign — 文字列変数への格納 (av_str の本体)
;   入力: U = 記述子 [len(1)][ptr(2)] のアドレス, STRPTR/STRLEN = 値
;   入口は str_asg_mark (ごみの印を立ててからここへ落ちる)。
;------------------------------------------------------------------------------
str_assign:
                ; 文字列変数は値を「所有」する。実体がプログラム本文
                ;   (TXTTAB..VARTAB) の中に在るときだけ、本文を
                ;   指すだけでよい (本文は代入より長生きする)。それ以外 —
                ;   直接モードの入力緩衝・関数結果の一時・他の変数の実体 — は
                ;   いずれ書き換わるので恒久ブロックへ複写して所有する。
                LDD     STRPTR
                CMPD    TXTTAB
                BLO     avs_own                 ; 本文より下 = 入力緩衝など
                CMPD    VARTAB
                BLO     avs_share               ; 本文中の定数 → 指すだけ
avs_own:
                TST     STRLEN
                BEQ     avs_share               ; 空文字列は実体を持たない
                JSR     str_own                 ; D = 確保して複写した実体先頭
avs_share:
                STD     1,U                     ; 実体先頭 (記述子 +1)
                LDA     STRLEN
                STA     ,U                      ; 長さ (記述子 +0)
                RTS
