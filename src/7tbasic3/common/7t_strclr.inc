;==============================================================================
; 文字列領域 — 変数領域と一時の開放
;   ROM の空きはアドレスアンカで区切られた区画ごとに独立しているため、文字列領域の
;   実装は複数の空きプールへ分けて配置してある。参照は全てラベル経由で位置
;   依存はない。
;==============================================================================
; vars_clear_all — 変数領域を「本文末尾から空」に揃える共通ルーチン。
;   文字列の記述子が全て消えるので、そのまま文字列領域の開放へ落ちる。
;   変数を全消去する場面では既定型宣言 (DEFINT/DEFSNG/DEFDBL/DEFSTR)
;     も既定 (単精度) へ戻す。CLEAR / RUN は全変数を消去し、型宣言はその
;     変数群に付随する属性なので一緒に解除する。
;   破壊: D。X は保つ (CLEAR は本文ポインタを X に持ったまま呼ぶ)。
vars_clear_all:
                JSR     deftype_reset   ; 既定型表を単精度へ戻す
                LDD     VARTAB
                STD     ARYTAB
                STD     STREND
; str_heap_reset — 恒久・一時の両方を空に戻す (変数が消えた直後に呼ぶ)。破壊: D。
str_heap_reset:
                LDD     MEMTOP
                STD     FRETOP
; str_tmp_clear — 一時領域を空に戻す (文の切れ目で呼ぶ)。破壊: D。
;   上の 2 本はここへ落ちてくる (同じ末尾を共有する)。
str_tmp_clear:
                LDD     STRBOT
                STD     TMPPTR
;------------------------------------------------------------------------------
; str_maybe_gc — 文の切れ目の詰め直し判定 (str_tmp_clear の尾部)。
;   ごみ (どの記述子も指していない実体) が出ているときだけ詰め直す。文の切れ目は
;   一時が 1 つも生きておらず、途中結果のポインタをハードウェアスタックや Y へ
;   退避している最中でもない唯一の安全な地点である。ここで詰めておかないと、
;   次の文の途中 (一時の確保) で空きが尽き、そこでは詰め直せないので
;   Out Of String Space になる。
;   ごみが無いときに走らせないのは、回収する物が無い詰め直しを毎文行うと
;   走行が目に見えて遅くなるため。
str_maybe_gc:
                TST     str_gcflg
                LBNE    str_gc          ; 詰め直しは別の区画に在るので長い分岐
                RTS
