; CMT 低レベル I/O ルーティン
;
; FM-7 CMT ハードウェア:
;   $FD00 write bit1: モーターON (1=ON, 0=OFF)
;   $FD02 read  bit7: テープ信号レベル ($80=HIGH / $00=LOW)
;
; テープ信号エンコーディング (FM-7 標準):
;   bit 0 → 2400 Hz キャリア (短パルス: HIGH半周期≈416サイクル)
;   bit 1 → 1200 Hz キャリア (長パルス: HIGH半周期≈768サイクル)
;   フレーム: スタートビット(0) + 8データビット(LSB先) + 2ストップビット(1)
;
; ブロックフォーマット (バイトストリーム。参考書籍の規定):
;   $FF... ギャップ (モータ ON のとき 10 バイト / OFF のとき 255 バイト)
;   $01    識別子1
;   $3C    識別子2
;   type   ブロックタイプ: $00=ヘッダ, $01=データ, $FF=エンド
;   len    データバイト数 (ヘッダは 20 固定、エンドは 0)
;   data   len バイト
;   csum   チェックサム (ギャップと識別子を除く全データの 2 進加算 mod 256)
;   $FF×4  エンドギャップ
;==============================================================================

;   (レベルが HIGH / LOW になるまで待つだけの補助はここには置かない。立ち上がり
;    待ちと計数は、テープ毎の校正を一手に行う cmt_measure_high が受け持つ。
;    当区画の予算は読取待ちの中断キー検査へ充ててある。)

;------------------------------------------------------------------------------
; cmt_delay_x: X * 12サイクルのディレイ (汎用ディレイ)
;   壊すレジスタ: X
;------------------------------------------------------------------------------
cmt_delay_x:
                LEAX    -1,X            ; 5cy
                CMPX    #1              ; 4cy
                BHS     cmt_delay_x     ; 3cy = 12cy/iteration (X が 0 になったら抜ける)
                RTS

;------------------------------------------------------------------------------
; cmt_measure_high: 立ち上がりエッジを待ち、HIGH 半周期の長さを計測する。
;   入力なし。出力: X = HIGH が続いた間のループ反復回数 (= パルス幅の指標)
;           キャリー=0 (立ち下がりまで計測できた)
;   壊すレジスタ: B, X
;
; 【待ちに打切りを置かない】信号が変化しない媒体 (装填していない・信号が
;   途切れた・イメージが尽きた) では、立ち上がりも立ち下がりも二度と来ない。この
;   場合に有限時間で終端と決めてしまうと、間隔や先導部の長いテープを読取の
;   途中で打ち切ってしまう (先導部とブロック間が信号レベルを保ったまま
;   長く続くテープもあり得る)。よって待ちには上限を
;   置かず、信号が変わるまで待ち続ける。利用者が読取をやめたいときは中断キー
;   で抜ける (実行環境と同じ)。中断キーは待ちの周回ごとに見る。
;
; 【途中経過は RAM に置かない】立ち上がり待ちの外側反復カウンタはシステム
;   スタックの 1 バイト枠に置く。テープ起動のプログラムの常駐型機械語ローダは
;   低位ページ ($0000-$00FF) 全域へ自前のイメージを置くことがあり、そのイメージには
;   実行コードが含まれ得る。読取 1 ビットごとに低位ページの作業変数を書くと、その
;   コードを書き潰してローダが別経路へ落ちる。よってビット読取の途中経過は
;   レジスタとシステムスタックだけで持ち、低位ページを 1 バイトも書かない。
;
; 1200baud FSK では 1 ビットが HIGH 半周期 1 つに対応し、その長さで
; 2400Hz(短) と 1200Hz(長) を区別する。固定サンプル点方式はテープ毎の
; パルス幅のばらつきに弱いため、HIGH→LOW 遷移までの実時間をその場で
; 計数して短/長を動的に閾値判定する (適応パルス幅判定)。
;
;   計数ループ 1 反復 = LEAX(5)+LDB(5)+ANDB(2)+BNE(3) = 15cy。
;   2400Hz HIGH 半周期 ≈ 416cy → 約 28 反復
;   1200Hz HIGH 半周期 ≈ 768cy → 約 51 反復
;   閾値 (CRB_THRESH) はこの中間に置き、短/長を分離する。
;------------------------------------------------------------------------------
cmt_measure_high:
                ; まず立ち上がり: LOW のうちは待つ。
                ; 待ちの反復には上限を置かない。内側 16bit の計数が一周したら
                ; 外周へ戻って中断キーを見直し、押されていなければそのまま待ち
                ; 続ける (信号の来ない媒体を待ち続けるのは実行環境と同じ挙動で、
                ; 脱出口は中断キー)。
                ;   立ち上がり待ちの所要時間は計測対象ではない (計測は立ち上がり
                ;   検出後の LDX #0 から始まる) ため、ここの反復コスト変化は
                ;   パルス幅判定 (CRB_THRESH 等) に影響しない。
                ; 計数ループは 1 反復 15cy を厳密に保つ必要がある (下の閾値定数は
                ; この反復コストで決めてある)。読取レジスタを直接ページ経由 (4cy)
                ; にすると 1 命令ぶんの余裕が生まれ、そこへ「計数が一周したときの
                ; 中断キー検査」を足しても反復コストが変わらない。よって計測の間
                ; だけ DP を $FD に置き、抜けるときに元へ戻す。
                PSHS    DP              ; 呼出元の直接ページを保存
                LDB     #$FD
                TFR     B,DP            ; DP = $FD (以降 <$02 が $FD02 を指す)
                LDB     #CMH_WAIT_OUTER
                PSHS    B               ; 外周カウンタ = スタック枠 1B (RAM を使わない)
cmh_wr_outer:
                ; --- 中断キー検査 (読取待ちからの脱出) ---
                ;   $FD04 (PORT_FIRQ) bit1 = 中断キー (0=押下)。立ち上がり待ちに
                ;   入る前の 1 回だけ見るので、計測区間 (cmh_count) の反復コストは
                ;   変わらず、パルス幅判定に影響しない。押下ならモータを止めて
                ;   直接モードへ戻る (無音のテープや存在しないファイルを待ち続けて
                ;   操作を受け付けなくなるのを防ぐ)。
                ;   ここは計数が一周した場合 (HIGH が続いたまま・LOW が続いたまま
                ;   のどちらも) の再入口でもある。HIGH が続いていれば下の立ち上がり
                ;   待ちが即 HIGH を見て cmh_rise_ok へ落ちるので、待ち続ける動作
                ;   そのものは変わらない。中断キーを見る間隔は、内側 16bit の
                ;   一周 (立ち上がり待ちで 18cy × 65535 ≒ 118 万サイクル、計数側で
                ;   15cy × 65536 ≒ 98 万サイクル) ごとになる。
                LDB     >PORT_FIRQ
                BITB    #$02
                LBEQ    brk_stop
                LDX     #$FFFF          ; 内側カウンタ (16bit)
cmh_wait_rise:
                LDB     PORT_CMT
                ANDB    #$80
                BNE     cmh_rise_ok     ; HIGH なら立ち上がり検出 → 計測へ
                LEAX    -1,X            ; 内側カウントダウン
                BNE     cmh_wait_rise   ; 未満了 → 待機継続
                DEC     ,S              ; 内側満了 → 外周の周回数を刻む
                BRA     cmh_wr_outer    ; 一周しても終端とせず、中断キーの検査へ戻る
                ;   (信号が来ない媒体は待ち続ける。周回数は待ちを打ち切る根拠には
                ;    使わない = 外周カウンタは診断用の刻みとスタック枠を兼ねる)
cmh_rise_ok:
                ; HIGH を確認。ここから LOW になるまで反復回数を数える。
                LDX     #0
cmh_count:
                LEAX    1,X             ; 反復カウント++ (5cy)
                BEQ     cmh_wr_outer    ; 3cy: 計数が一周 (65536 反復ぶん HIGH が
                                        ;   続いた) → 中断キーの検査だけを通して
                                        ;   計測をやり直す。
                                        ;   ここを終端と決めてはならない: 正規の
                                        ;   テープでもブロック間の間隔や先導部で
                                        ;   HIGH が 100 万反復を超えて続くイメージがあり
                                        ;   (動作観察)、終端扱いにすると読取が途中で
                                        ;   打ち切られる。信号が HIGH のまま止まる
                                        ;   装置状態は「信号が来ない媒体」であって、
                                        ;   利用者が中断キーを押すまで待ち続けるのが
                                        ;   実行環境の動作なので、押下の検査だけを
                                        ;   一周ごとに通す。分岐不成立の 3cy を含めても、
                                        ;   この反復コストは一定のままである。
                LDB     <$02            ; 4cy: 1 回目読み取り (DP=$FD → $FD02)
                BMI     cmh_count       ; 3cy: HIGH → 継続 (計 15cy = 判定閾値が前提とする値)
                ; LOW を 1 回検出。半周期(特に長=1200Hz)の途中に乗る短い LOW 割れ
                ; (グリッチ)で早期に打ち切ると、長半周期が短側へ誤計数されビット
                ; 判定・スタートビット検出が崩れる。3 回連続 LOW を真の立ち下がり
                ; 条件にしてディップを吸収する。
                LDB     PORT_CMT        ; 2 回目確認
                ANDB    #$80
                BNE     cmh_count       ; 実は HIGH (グリッチ) → 継続
                LDB     PORT_CMT        ; 3 回目確認
                ANDB    #$80
                BNE     cmh_count       ; 実は HIGH (グリッチ) → 継続
                ; --- クロック周波数の切替への追従 ---
                ;   計数は CPU のサイクルで進むので、動作クロックが 1.2 MHz (参考書籍:
                ;   $FD00 bit0 = 0) のときは同じ半周期でも反復数が 2 MHz の 0.614 倍
                ;   (1.2288 / 2.0) にしか届かない。ここで 1.625 倍 (= 1 + 1/2 + 1/8)
                ;   に伸ばして 2 MHz の目盛に揃え、後段の閾値 (CRB_*) を共通にする
                ;   (参考書籍が定める「クロック周波数に応じた切替」)。
                LDB     <$00            ; $FD00 bit0 = 0: 1.2 MHz / 1: 2 MHz (DP = $FD)
                LSRB
                BCS     cmh_fin         ; 2 MHz → そのまま
                TFR     X,D
                LSRA
                RORB                    ; D = X / 2
                LEAX    D,X             ; X = 1.5 X
                LSRA
                RORB
                LSRA
                RORB                    ; D = X / 8
                LEAX    D,X             ; X = 1.625 X
cmh_fin:
                ANDCC   #$FE            ; キャリー=0 (成功)。EOT 伝播判定用に明示
                PULS    B,DP,PC         ; 3 回連続 LOW = 真の立ち下がり。X = 半周期長指標

; スタートビットを「短(2400Hz)」と認める上限 (cmt_measure_high の反復数)。
;   計数ループ 1 反復 ≈ 15cy。短(2400Hz,~416cy)≈28, 長(1200Hz,~768cy)≈51。
;   テープ個体により短側が ~470cy(≈31反復)まで伸び、長側が ~616cy(≈41反復)
;   まで縮む例があるため、確実に分離できる中間 35 に置く。
CRB_THRESH      EQU     40

; 適応閾値のクランプ範囲。スタートビット幅 W から W×1.5 を作り、この範囲に
; 収める。短(2400Hz)≈28・長(1200Hz)≈56 を分離しつつ、テープ毎の偏りに追従。
;   下限 38: 短側が太いテープでも短を短と判定する実績下限。
;   上限 44: 長側が細いテープは長半周期の最小が ~45 反復まで縮むため、閾値が
;            それを越えると長を短と誤判定する。45 を確実に長側へ含めるよう 44。
CRB_THRESH_LO   EQU     38
CRB_THRESH_HI   EQU     44

; スタートビットとして認める短 HIGH 半周期の下限 (cmt_measure_high の反復数)。
;   一部のテープイメージはブロック間のリーダー/無音領域に幅の極めて狭い HIGH
;   ヒゲ(数十サイクル=反復数 1〜8 程度)を含む。これを短(2400Hz)スタート
;   ビットと誤認すると無音域からフレーム化を始めてしまい、本来のリーダーに
;   一度も同期できず読み取りが総崩れになる。正規の短半周期(~416cy)は反復数
;   16 以上になるため、明らかに細すぎる HIGH (< CRB_MIN) はスタートビット
;   候補から除外し、確かなキャリアが現れるまで待つ。
;   下限 12: 計測した正規短(最小 16) と ヒゲ(最大 ~8) を確実に分離する中間値。
CRB_MIN         EQU     12

; cmt_measure_high 立ち上がり待ちの外周カウンタ初期値。
;   待ちに上限は無い (一周しても終端とせず、中断キーが押されていなければ待ち
;   続ける)。この値は外周を何周したかを刻むだけで、待ちの打切りには使わない。
;   スタック枠 1 バイトを確保する初期値として 16 を置く。
CMH_WAIT_OUTER  EQU     16

;------------------------------------------------------------------------------
; cmt_read_byte: テープから1バイト読み取り (適応サンプル点方式)
;   出力: A = 読み取ったバイト, キャリー = 0 (成功) / キャリー = 1 (テープ終端)
;   壊すレジスタ: A, B, X, Y
;
; 【途中経過は RAM に置かない】適応閾値はシステムスタックの 2 バイト枠、
;   組立中のバイトは A に持つ。テープ読取中に低位ページを 1 バイトも書かない
;   ための規約 (根拠は cmt_measure_high の頭書き)。
;
; アルゴリズム (適応サンプル点):
;   固定サンプル点方式はテープ毎にパルス幅分布が異なると短/長の境界を
;   外して読めなくなる。一方で「半周期の幅をそのまま計数する」方式は、
;   半周期の途中に細かい LOW 割れ(グリッチ)が乗るテープで早期打ち切りを
;   起こし同期が崩れる。そこで両者の弱点を避け、
;     (1) スタートビットの短(2400Hz)半周期の長さを計測して基準 W を得る、
;     (2) その W から「短なら確実に立ち下がり済み・長ならまだ HIGH」となる
;         サンプル遅延を毎テープ動的に校正し、
;     (3) データビットは立ち上がりからその遅延だけ待って 1 点だけ判定する。
;   1 点判定なのでグリッチに強く、遅延がテープ毎に校正されるので
;   パルス幅分布の違いにも追従する。
;
;   スタートビット検出: HIGH を測り「短(< 閾値)」が来るまで読み飛ばす。
;     得た反復数 W から サンプル遅延 (cmt_delay_x 用) を計算して保存。
;     短 HIGH ≈ W×15cy。サンプル遅延 ≈ 1.6×(短HIGH) を狙い、
;     delay_x(12cy/反復) で D = round(W×15×1.6/12) ≈ W×2 反復とする。
;     → 短半周期(~W×15cy)終了後で LOW、長半周期(~2×W×15cy)継続中で HIGH。
;   データビット×8: 立ち上がり待ち → 遅延 D → bit7 を 1 点サンプル。
;   ストップビット×2: HIGH を確認。
;------------------------------------------------------------------------------
cmt_read_byte:
                ; 各ビットセル = HIGH 半周期 1 個 (短=2400Hz='0' / 長=1200Hz='1') +
                ; LOW 半周期 1 個。フレーム = スタートビット(0) + 8データ(LSB先) +
                ; ストップビット(1)×2。
                ;
                ; ビット判定は cmt_measure_high で HIGH 半周期長を計測し、閾値
                ; CRB_THRESH で短/長を直接分類する。cmt_measure_high は HIGH を
                ; 1 個ぶん消費して立ち下がり(LOW)で復帰するため、各ビットの境界に
                ; ぴったり揃い、バイト間・ストップビット境界でも位相がずれない。
                ; (「立ち上がりから固定遅延で 1 点サンプル」方式はバイト 2 以降で
                ;  位相がずれるため、幅で分類する。)
                ;
                ; スタートビット待ち: 短 HIGH(='0') が来るまで読み飛ばす。
crb_start:
                BSR    cmt_measure_high ; X = 直近 HIGH 半周期長 (反復数)
                BCS     crb_eot0         ; EOT (終端) → 閾値枠を積む前なのでそのまま脱出
                CMPX    #CRB_THRESH
                BHS     crb_start        ; 長 HIGH → スタートビットでない → 測り直し
                CMPX    #CRB_MIN
                BLO     crb_start        ; 細すぎる HIGH (リーダー/無音のヒゲ) → 無視
                ; 短 HIGH = スタートビット。立ち下がりで復帰済み (LOW)。
                ; 適応閾値を算出: スタートビット(=短='0')の計測幅 W から
                ; 閾値 = W × 1.5 を作る (長='1' は短の約2倍幅なので W と 2W の中点)。
                ; テープ毎にパルス幅分布が偏っても短/長の境界に追従できる。
                ; 安全範囲 [CRB_THRESH_LO, CRB_THRESH_HI] にクランプする。
                ; (X = 受理したスタートビット幅。B を作業に使う)
                TFR     X,D              ; D = W (A:B, W<256 なので B=幅下位, A=0)
                LSRB                     ; B = W/2 (A は 0 のまま)
                ABX                      ; X = W + W/2 = W*1.5 (X は元々 W)
                ; X = round(W*1.5)。安全範囲にクランプ。
                ; (クランプ本体は 7t_diskboot.inc の cmt_thresh_clamp へ移設し、
                ;  空いた位置へ 連携サービス入口を差し込む)
                JSR     cmt_thresh_clamp
;------------------------------------------------------------------------------
; 連携サービス入口 — 行取得サブ (CHRGET) の文字分類尾部
;   RAM 常駐の行取得サブ ($00D2) が末尾で JMP してくる互換入口。
;   本体は 7t_diskboot.inc (通常フローは直前の JSR から cdt_store へ飛び越える)。
;------------------------------------------------------------------------------
                BRA     cdt_store
crb_eot0:
                ; スタートビット待ちでのテープ終端。閾値枠はまだ積んでいないので
                ; そのまま (キャリー=1 のまま) 復帰する。
                RTS

;------------------------------------------------------------------------------
; SWAP <変数>, <変数>  — 2 つの変数の値を交換する
;   (参考書籍「一般ステートメント」SWAP)
;
;   参考書籍の規定どおり、整数・単精度・倍精度・文字のいずれの型でも交換できるが、
;   2 つの変数の型は同じでなければならず、一致しないときは Type Mismatch とする。
;   交換は値の記録域どうしをそのまま入れ換える。文字変数は記述子 (長さ+実体
;   ポインタ) を入れ換えるので、実体の複写も確保も起きない。
;
;   第 1 変数のアドレスは CPU スタックでなく let_tgt へ置く。第 2 変数の参照が
;   未定義のスカラ変数を作るとスカラ域が伸びて配列ブロックが丸ごと上へ動くが、
;   let_tgt なら vars_make_room が移動量ぶん追従させてくれる (LET と同じ理由)。
;
;   (本体は空きのまとまった当プールへ置く。参照はラベル経由のみで位置依存なし)
;------------------------------------------------------------------------------
impl_swap:
                JSR     get_var_ref_chk         ; U = 第1変数の値アドレス
                STU     let_tgt
                LDA     VARTYP
                PSHS    A                       ; 第1変数の型
                JSR     skip_comma
                LBCC    errc_2                  ; ',' が無い → Syntax Error
                JSR     get_var_ref_chk         ; U = 第2変数の値アドレス
                LDA     VARTYP
                CMPA    ,S+
                LBNE    err_tmm                 ; 型が違う → Type Mismatch
                PSHS    X                       ; 本文ポインタ (vn_valsize が壊す)
                JSR     vn_valsize              ; B = 値のバイト数 (型別)
                TFR     U,X                     ; X = 第2変数
                LDU     let_tgt                 ; U = 第1変数 (動いていれば追従済)
                JSR     swap_bytes
                PULS    X,PC
cdt_store:
                PSHS    X                ; 適応閾値 = スタック枠 2B (低位ページを使わない)
                CLRA                     ; A = 結果ビット組立用アキュムレータ
                LDY     #0               ; ビットカウンタ
crb_bit:
                LBSR    cmt_measure_high ; このビットの HIGH 半周期長を計測 (A は保存)
                BCS     crb_rb_eot       ; EOT (終端) → キャリー=1 で即脱出
                ; 短(< 適応閾値) → '0', 長(>= 適応閾値) → '1' を C へ
                CMPX    ,S               ; X < 閾値 で C=1 (短=0), X>=閾値 で C=0 (長=1)
                BHS     crb_one          ; 長 → ビット=1
                ANDCC   #$FE             ; 短 → ビット=0 (キャリークリア)
                BRA     crb_shift
crb_one:
                ORCC    #$01             ; 長 → ビット=1 (キャリーセット)
crb_shift:
                RORA                     ; キャリー → A bit7 (LSB 先収集)
                LEAY    1,Y              ; ビットカウント++
                CMPY    #8
                BNE     crb_bit          ; 8ビット未満 → 継続
                ; 8ビット収集完了 (結果バイトは既に A にある)
                ; ストップビット×2 (長 HIGH) を消費し、次バイトの境界へ揃える。
                LBSR    cmt_measure_high ; ストップビット1 を消費 (立ち下がりで復帰)
                BCS     crb_rb_eot       ; EOT (終端) → キャリー=1 で即脱出
                LBSR    cmt_measure_high ; ストップビット2 を消費 (立ち下がりで復帰)
                BCS     crb_rb_eot       ; EOT (終端) → キャリー=1 で即脱出
                ANDCC   #$FE             ; キャリークリア (成功)
                PULS    X,PC             ; 閾値枠を捨てて復帰 (X は破壊対象)
crb_rb_eot:
                ; テープ終端。キャリー=1 のまま (成功=0 と区別できる) 復帰し、
                ; cmt_read_block でブロック読み取り失敗として扱わせる。終端か
                ; チェックサム誤りかの区別は cmt_read_block が B で返す。
                PULS    X,PC             ; 閾値枠を捨てて復帰 (キャリーは保つ)

;------------------------------------------------------------------------------
; cmt_read_block: テープから1ブロック読み取り
;   リーダー ($FF×5以上) + 同期 $01 $3C を検出し、
;   ブロックタイプ/長さ/データ/チェックサムを読み取る
;
;   出力:
;     cmt_blk_type = ブロックタイプ (00=ヘッダ, 01=データ, FF=エンド)
;     cmt_blk_len  = データ長
;     U レジスタ   = データ格納先 (呼び出し前にセット)
;   戻り値:
;     キャリー = 0 → 成功
;     キャリー = 1 → 失敗。**失敗の種別は B で返す**
;                      B = 0    → チェックサムエラー (再試行すれば読める)
;                      B ≠ 0   → テープ終端 (EOT。再試行しても永久に読めない)
;                    上位のヘッダ探索は B を見て再試行と脱出を分ける。
;                    種別を RAM のフラグに置かないのは、テープ読取中に低位
;                    ページを 1 バイトも書かないため (cmt_measure_high の
;                    頭書き参照)。
;   壊すレジスタ: A, B, X, Y, U (データ書込後に進む)
;   格納の上限: ヘッダ探索は cmt_read_hdr (20 byte まで) から入る。通常の入口は
;   上限なし (255 byte)。上限を超えた分は読み飛ばし、チェックサムには加える。
;------------------------------------------------------------------------------
; cmt_read_hdr: ヘッダ探索用の入口。格納を cmt_hdr_buf の大きさ (20 byte) までに
;   限り、それを超える分は緩衝へ書かずに読み飛ばす (チェックサムには加える)。
;   ヘッダ探索はブロックの種別を確かめる前に読み込むので、別ファイルの本文
;   ブロック (最大 255 byte) に出会うと 20 byte の緩衝を溢れ、$00AE 以降の
;   ワーク (cmt_lead_cnt / mlm_dev / MEMTOP ほか) を潰していた。
;   参考書籍のとおりヘッダブロックのデータは 20 byte なので、
;   本物のヘッダは欠けずに入る。戻り値は cmt_read_block と同じ。
cmt_read_hdr:
                LDB     #20             ; 格納の上限 = cmt_hdr_buf の大きさ
                BRA     crb_begin
cmt_read_block:
                LDB     #$FF            ; 上限なし (データ長は最大 255)
crb_begin:
                PSHS    B               ; ,S = まだ格納できる byte 数
                ; パルス幅の計測はタイマ割込のジッタに敏感なため、
                ; ブロック読取り中は周期タイマを止める (出口で再開)。
                JSR     time_pause
                ; リーダー検出: $FF を5バイト連続で読む
                ; 注: cmt_read_byte はパルス幅計測の中で B を破壊するため、
                ;     連続カウンタは RAM (cmt_lead_cnt) に保持する。
crb_leader:
                LDA     #5
                STA     cmt_lead_cnt    ; 連続 $FF カウンタ初期化
crb_lead_lp:
                BSR     crb_getb   ; 1バイト読む (B 破壊)
                CMPA    #$FF
                BNE     crb_leader      ; $FF 以外 → カウントリセット
                DEC     cmt_lead_cnt
                BNE     crb_lead_lp     ; 5個連続で OK
                ; 残りの $FF をスキップして $01 同期バイトを探す
crb_skip_ff:
                BSR     crb_getb
                CMPA    #$FF
                BEQ     crb_skip_ff     ; 続く $FF はスキップ
                ; $01 か確認
                CMPA    #$01
                BNE     crb_leader      ; $01 以外 → やり直し
                ; $3C か確認
                BSR     crb_getb
                CMPA    #$3C
                BNE     crb_leader      ; $3C 以外 → やり直し
                ; ブロックタイプ読み取り
                BSR     crb_getb
                STA     cmt_blk_type
                ; 偽 sync 弾き (LOADM の 2 個目以降ヘッダ探索限定)。
                ;   リーダー中に埋め込まれた偽の $01 $3C の直後には無効な
                ;   ブロックタイプ ($FF 等) が続く。cmt_strict_hdr が立っている
                ;   ときだけ、参考書籍に無いブロックタイプ
                ;   (00 ヘッダ / 01 データ / FF エンド 以外) を偽 sync とみなし、
                ;   リーダー再探索へ戻して後続の真ヘッダ ($01 $3C 00 ...) へ整列し直す。
                ;   フラグ 0 の LOAD/データ読取/常駐ローダ入力はこの判定を行わない。
                TST     cmt_strict_hdr
                BEQ     crb_type_ok
                CMPA    #2
                BLO     crb_type_ok     ; 00 / 01
                CMPA    #$FF
                BNE     crb_leader      ; FF 以外 = 偽 sync → リーダー再探索
crb_type_ok:
                ; データ長読み取り
                BSR     crb_getb
                STA     cmt_blk_len
                ; チェックサム計算開始: type + len
                LDB     cmt_blk_type
                ADDB    cmt_blk_len
                STB     cmt_chk_sum
                ; データバイト読み取り。
                ; カウンタは cmt_lead_cnt (リーダー検出後は空き) に置き、
                ; cmt_blk_len は破壊しない。
                ; (機械語ロードの mlm_get_byte はブロック読み取り後に
                ;  cmt_blk_len を参照してそのブロックのデータ長を得る。
                ;  ここで cmt_blk_len をカウンタ兼用にして 0 まで減らすと
                ;  長さ情報が失われ、読み込んだデータブロックが丸ごと
                ;  破棄されてしまう。cmt_read_byte は B を壊すため
                ;  レジスタではなく RAM 上のカウンタを使う。)
                LDA     cmt_blk_len
                BEQ     crb_no_data     ; 長さ0 → データなし
                STA     cmt_lead_cnt    ; 残りバイト数カウンタ
crb_data_lp:
                BSR     crb_getb   ; A = 読んだバイト
                TST     ,S              ; 格納の上限に達したら書かずに読み飛ばす
                BEQ     crb_nostore
                DEC     ,S
                STA     ,U+             ; バッファに格納
crb_nostore:
                ; チェックサム更新: cmt_chk_sum += A
                ADDA    cmt_chk_sum
                STA     cmt_chk_sum
                DEC     cmt_lead_cnt
                BNE     crb_data_lp
crb_no_data:
                ; チェックサムバイト検証
                BSR     crb_getb
                CMPA    cmt_chk_sum
                BNE     crb_cksum_err
                CLR     >CAS0_ERR       ; CAS0 エラー種別 = エラーなし
                JSR     time_resume     ; タイマ再開 (シャドウの状態へ)
                ANDCC   #$FE            ; 成功
                PULS    A,PC            ; 格納上限の枠を捨てて復帰 (A は破壊対象)
; crb_getb — テープから 1 バイト読む。終端なら呼び出し元へ戻らず crb_eot_err
;   へ抜ける。同じ 2 命令の並びがブロック読取りの各所に現れるので 1 本にまとめた
;   (容量の都合。読み出す値と分岐先は変わらない)。
crb_getb:
                LBSR    cmt_read_byte
                BCC     crb_getb_ok
                LEAS    2,S             ; 呼び出し元の戻りアドレスを捨てる
                BRA     crb_eot_err
crb_getb_ok:
                RTS

crb_cksum_err:
                LDA     #1              ; CAS0 エラー種別 = チェックサムエラー
                STA     >CAS0_ERR       ;   (参考書籍「$02D5」)
                CLRB                    ; B=0 → チェックサムエラー (再試行可)
                BRA     crb_fail
crb_eot_err:
                LDA     #2              ; CAS0 エラー種別 = 読み込みエラー
                STA     >CAS0_ERR
                LDB     #$FF            ; B≠0 → テープ終端 (再試行しても読めない)
crb_fail:
                JSR     time_resume     ; タイマ再開 (シャドウの状態へ。B は保存される。
                                        ;   CC は変化するので直後に ORCC で立て直す)
                ORCC    #$01            ; キャリーセット = エラー
                PULS    A,PC            ; 格納上限の枠を捨てて復帰 (B と CC は保つ)

;------------------------------------------------------------------------------
; LOAD コマンド実装
;   構文: LOAD ["ファイル名"]
;   動作:
;     1. モーターON
;     2. ヘッダブロック読み取り (ファイル名照合)
;     3. データブロック読み取り → TXTTAB 以降に格納
;     4. 終端ブロック検出 → 終了
;     5. VARTAB 更新、プログラム終端マーカー ($00 $00) 書き込み
;     6. モーターOFF
;------------------------------------------------------------------------------
; skip_spc: X が指す位置から空白 (SPACE $20) を読み飛ばす。
;   保存済み本文では命令語と引数の間に利用者が打った空白がそのまま
;   残る (例: LOADM "DATA1" の M と " の間)。引数解析の前に必ず除去する。
;   入力/出力: X = 最初の非空白を指す。A 破壊のみ (B/CC 等は保つ)。
;   実装は式評価器の skip_sp_x (7t_expr.inc) と完全に同一なので、別名 (EQU) と
;   して 1 本に共通化する (P4 の容量捻出)。
skip_spc        EQU     skip_sp_x

impl_load:
                ; オーディオカセット系コマンドは演奏を中断する (参考書籍)
                JSR     play_stop
                CLR     cmt_strict_hdr          ; 偽 sync 弾きは既定 OFF (LOADM で立てる)
                ; LOADM 判定: LOAD トークン直後に 'M' があれば機械語ロード。
                ; (F-BASIC では LOADM = LOAD トークン + リテラル 'M')
                LDA     ,X
                CMPA    #'M'
                LBEQ    impl_loadm
                ; LOAD? : テープ上のチェックサムの照合 (参考書籍 LOAD?)。
                ; '?' は行変換器が PRINT の省略形のトークンにするので、その値で見る
                CMPA    #TOK_QMARK
                LBEQ    impl_loadq
                JSR     skip_spc                ; LOAD と引数の間の空白を除去
                ; ファイル名解析 + ",R" (ロード後自動実行) 解析を一括で行う。
                ; impl_load_fname_r は impl_parse_fname を呼んだ後、続く ",R" を解析して
                ; mlm_run (0=無/1=有) に記録する (本体は空きプール)。
                ; 当区間は空きが無いため、追加ロジックは別プールへ置き、
                ; ここは呼び出し 1 個 (JSR 1 本ぶんの長さ) に留める。
                JSR     impl_load_fname_r       ; ファイル名 + ,R 解析 → cmt_filename/dl_device/mlm_run
                ; 装置分岐: dl_device bit7=1 (ディスク) ならディスク経路へ。
                ; カセット経路 (bit7=0) は以降このままテープ経路。ディスク経路は
                ; disk_load_body 内で展開・再リンクまで完結して RTS する。
                LDA     dl_device
                LBMI    disk_load_body
                ; ディスパッチャ復帰用 X (引数末尾) を先に積む。ブロック読取
                ; (cmt_read_block) が X を壊すため、以降の全経路はここで積んだ
                ; 値を出口 (il_asc_go / il_data_err / ilm_done) で戻す。
                PSHS    X
                ; モーター ON
                JSR     cmt_motor_on    ; モータ ON (控えも更新)
                ; ヘッダブロック待ちループ
il_header:
                LDU     #cmt_hdr_buf            ; ヘッダデータ一時バッファ (20B, RAM)
                JSR     cmt_read_hdr            ; 格納は 20B まで (ヘッダでない本文
                                                ;   ブロックで後続のワークを潰さない)
                BCC     ilh_have               ; 成功 → 内容確認へ
                TSTB                           ; 失敗: EOT (B≠0) か CRC エラー (B=0) か
                BNE    il_data_err            ; EOT → 無限再試行せずモータ OFF で復帰
                BRA     il_header              ; CRC エラー → 再試行
ilh_have:
                LDA     cmt_blk_type
                BNE     il_header               ; type≠0 → ヘッダブロックでない → 再試行
                ; ヘッダブロック取得成功
                ; ファイル名照合 (cmt_filename が空なら任意 = 無条件受け入れ)
                JSR     cmt_name_chk
                BCS     il_header               ; 不一致 → 別のブロックを探す
                ; ヘッダのファイル形式 (+8) と属性 (+9) で受理する形式を決める。
                ;   $00 $FF = BASIC ソースのアスキー形式 (参考書籍の
                ;             ヘッダブロックの形式・属性。値は参考書籍の
                ;             ファイルタイプ 0 / アスキーフラグ $FF) → 行取込へ。
                ;   それ以外 (機械語ファイル $02、バイナリ形式 $00 $00 ほか) は
                ;   Bad Data In File (参考書籍の 58 =「ファイル上のデータの
                ;   形式が間違っている」)。機械語ファイルは LOADM で読む (参考書籍
                ;   LOAD は BASIC プログラムの読込み)。
                LDD     cmt_hdr_buf+8
                STD     >FIL_TYPE       ; ファイルタイプ / アスキーフラグ
                                        ;   (参考書籍「$02DB」「$02DC」)
                COMB                            ; 属性 $FF→$00 / $FE→$01 (保護)
                CMPD    #$0001                  ; 形式 $00 かつ属性 $FF/$FE だけ受理
                LBHI    bdf_err                 ; モータ停止 + Bad Data In File
                STB     prot_flag               ; 保護状態を本文へ引き継ぐ
il_legacy:
                BSR     il_stream_prep          ; 緩衝初期化 + 供給 = テープ (MERGE と共用)
                ; (ディスパッチャ復帰用 X は impl_load が装置分岐直後に積んで
                ;  ある。テープの本文緩衝が INPBUF を使わなくなったことと併せ、
                ;  LOAD 完了後に直接モードの行を正しく続行できる)
                BSR     prog_clear_new          ; プログラムを空に (NEW 相当)
                BSR     stream_lines            ; CR 区切りで各行を原文のまま挿入
                JSR     cmt_motor_off           ; モーター OFF
                JSR     il_ret_run              ; ,R 指定なら自動 RUN (戻らない)
                PULS    X,PC ; ディスパッチャ復帰用 X
                ; モーター OFF (エラー終了。,R が指定されていてもロード失敗ゆえ実行しない)
il_data_err:
                JSR     cmt_motor_off
                PULS    X                       ; ディスパッチャ復帰用 X を戻す
                ANDCC   #$FE
                RTS

;------------------------------------------------------------------------------
; il_legacy: BASIC プログラムのテープ LOAD 本体。
;
;   参考書籍記載のとおり、テープの本文は
;   連続バイト列を 1 データブロック (最大255バイト) ずつに詰めた形であり、
;   1 ブロックに複数行が入り、1 行がブロック境界を跨ぐこともある。
;   本実装は il_get_byte (type=1 ブロックを跨いで論理 1 バイトずつ供給し、
;   type≠1 でキャリー。緩衝は DA_SECBUF なので INPBUF = 直接モードの実行中の
;   行を壊さない) でバイト列を読み、共通の行取込 (stream_lines) で原文のまま
;   挿入する。
;     il_legacy = アスキー形式 (ヘッダの形式 $00 / 属性 $FF)
;------------------------------------------------------------------------------
;------------------------------------------------------------------------------
; stream_lines — 論理バイトストリームを CR($0D) 区切りで 1 行ずつ取り出し、
;   行頭が数字の行のみ impl_insert_line で原文のまま挿入する共通行取込。
;   テープ (il_get_byte) とディスク (disk_get_byte) の両 LOAD、および MERGE が
;   共用する (以前のバージョンまで媒体別に 2 本あった同型ループの一本化)。
;   入力: U = 論理バイト供給ルーチン (A=バイト, C=1 終端。U を保存する規約)
;   終端: 供給の尽き (C=1) または終端記号 $1A。LF($0A) は無視。1 行がブロック/
;   セクタ境界を跨いでもよい (供給側が吸収)。プログラム消去 (NEW) は行わない
;   (呼出側が用途に応じて事前処理: LOAD は全置換、MERGE は併合)。
;   行組立の書込ポインタは供給側が X/Y を壊すため RAM (mlm_offset) に保持する。
;   破壊: A,B,X,mlm_offset (U は保存)
;------------------------------------------------------------------------------
sl_eol:
                BSR     sl_line                 ; 行確定 (数字始まりのみ挿入)
                ; fallthrough: 次の行頭へ
stream_lines:
sl_newline:
                LDX     #str_work_buf           ; 行組立バッファ先頭
                STX     mlm_offset              ; 行書込ポインタ (RAM 保持)
sl_getc:
                JSR     ,U                      ; A=論理バイト, CS=データ終端
                BCS     sl_eof
                CMPA    #$1A                    ; 終端記号 (SAVE が本文の末尾に置く)
                BEQ     sl_eof
                CMPA    #$0D                    ; CR → 行確定
                BEQ     sl_eol
                CMPA    #$0A                    ; LF → 無視
                BEQ     sl_getc
                ; 通常文字 → 行バッファへ追記 (オーバフロー保険)
                LDX     mlm_offset
                CMPX    #str_work_buf+255       ; 論理行は最大 255 文字 (§2.2)。
                                                ;   上限を 250 とすると 251-255
                                                ;   文字目を捨て、長行末尾の引数が
                                                ;   欠落する (PAINT 境界色が既定へ
                                                ;   化ける等)
                BHS     sl_getc                 ; 上限超過分は捨てる
                STA     ,X+
                STX     mlm_offset
                BRA     sl_getc
sl_eof:
                ; データ終端。CR 無しで残った最終行があれば挿入して終了
                ; (残りが無ければ sl_line 内の空行判定がそのまま何もしない。
                ;  sl_line の RTS が呼出元への復帰を兼ねる = 末尾呼び)。
sl_line:
                ; 行確定: $00 終端 → 数字始まりなら挿入
                LDX     mlm_offset
                CLR     ,X
                LDA     str_work_buf
                BEQ     sl_ret                  ; 空行はスキップ
                CMPA    #'0'
                BLO     sl_ret
                CMPA    #'9'
                BHI     sl_ret
                ; 挿入。impl_insert_line が使う作業は mlm_offset だけで、
                ; ストリーム状態 (mlm_bptr/mlm_brem/dl_*/da_bptr) とは非干渉。
                ; mlm_offset は行頭 (sl_newline) で毎行設定し直すので安全。
                LDX     #str_work_buf
                JMP     impl_insert_line
sl_ret:
                RTS


; (cmt_name_chk は容量の都合で 7t_startup.inc の空きプールへ配置)

;------------------------------------------------------------------------------
; prog_clear_new — プログラムを NEW 直後と同じ状態へ戻す。
;   本文を空に (TXTTAB へ [00 00]、VARTAB = 直後) したうえで、NEW と同じ 3 つの
;   後始末を行う。
;     vars_clear_all … 全変数・配列・文字列領域を空に (既定型宣言も既定へ)
;     fn_clear_tbl   … DEF FN 定義表を消す。定義表のスロットは定義行の位置を
;                      持つので、本文が入れ替わると別物を指したまま残る
;     cont_clear     … 本文が入れ替わるので CONT の再開位置は無効
;   LOAD は読み込む行が 0 本でも変数と DEF FN 定義を消す (参考書籍の F-BASIC
;   参考書籍: LOAD は変数をクリアする。DEF FN 定義はその変数群に付随する)。
;   行が 1 本以上あれば行挿入 (impl_insert_line) が変数と CONT 位置を消すが、
;   DEF FN 定義表はどの経路も消さないため、ここでまとめて消す。
;   テープ/ディスクの LOAD 本体 (il_asc_go / dal_new) と NEW (impl_new) が共用。
;   呼出側は U に本文の供給ルーチンを載せたまま呼ぶ。ここから呼ぶ 3 本はいずれも
;   U と Y を保つ (vars_clear_all は str_maybe_gc → str_gc も含めて U/Y/X を積んで
;   戻す。fn_clear_tbl は X/B、cont_clear は何も使わない)。
;   破壊: D, X (U, Y は保つ)
;------------------------------------------------------------------------------
prog_clear_new:
                LDX     TXTTAB
                CLR     ,X
                CLR     1,X
                LEAX    2,X
                STX     VARTAB
                JSR     vars_clear_all  ; 変数・配列・文字列領域を空に
                JSR     fn_clear_tbl    ; DEF FN 定義表もクリア (旧本文ポインタの残留を防ぐ)
                JMP     cont_clear      ; 本文が入れ替わった後は CONT で再開できない

;------------------------------------------------------------------------------
; il_stream_prep — テープ本文ストリームの初期化 (LOAD と MERGE が共用)。
;   復帰時は U = il_get_byte (続けて行取込に使える)。
;------------------------------------------------------------------------------
il_stream_prep:
                CLR     mlm_brem                ; バイトストリームの緩衝を空に
                LDU     #il_get_byte            ; 本文供給 = テープ
                RTS

;------------------------------------------------------------------------------
; il_get_byte: BASIC テキストのデータブロック列から論理 1 バイトを取り出す。
;   mlm_get_byte と同じ規約 (A=バイト, C=1 終端。type≠1 で終端) だが、ブロック
;   緩衝に DA_SECBUF を使う点だけが違う。mlm_get_byte の緩衝 (INPBUF) は直接
;   モードの実行中の行そのものなので、LOAD/MERGE の本文読取に使うと復帰後の
;   行が壊れる (以前のバージョンで LOAD 直後に Syntax Error が出ていた根)。機械語系
;   (LOADM/EXEC/1 文字入力) は常駐ローダの受け渡し規約のため INPBUF のまま変えない。
;   DA_SECBUF は SPACE$/STRING$ の式評価と排他 (読取中は式評価が走らない)。
;   出力: A = バイト, C=0 成功 / C=1 終端。破壊: A,B,X,Y (U は保存)
;------------------------------------------------------------------------------
il_get_byte:
                PSHS    U                       ; 供給ベクタ (,U 呼出) を保全
                LDA     mlm_brem
                BNE     igb_serve               ; 緩衝に残りあり
igb_fill:
                LDU     #DA_SECBUF
                JSR     cmt_read_block
                BCC     igb_have                ; 成功 → タイプ確認へ
                TSTB                            ; 失敗: EOT (B≠0) か CRC (B=0) か
                BNE     igb_eof                 ; EOT → データ終端扱い
                BRA     igb_fill                ; CRC エラー → 再試行
igb_have:
                LDA     cmt_blk_type
                CMPA    #1
                BNE     igb_eof                 ; type≠1 → データ終端
                LDA     cmt_blk_len
                BEQ     igb_fill                ; 長さ0 → 次ブロック
                STA     mlm_brem
                LDD     #DA_SECBUF
                STD     mlm_bptr
igb_serve:
                LDU     mlm_bptr
                LDA     ,U+
                STU     mlm_bptr
                DEC     mlm_brem
                ANDCC   #$FE                    ; C=0 成功
                PULS    U,PC
igb_eof:
                ORCC    #$01                    ; C=1 終端
                PULS    U,PC

;------------------------------------------------------------------------------
; impl_loadm: LOADM ["ファイル名"][,アドレス][,R]
;   機械語 (file-type=$02) ファイルをテープから読み、所定アドレスへ展開する。
;   入力: X = LOAD トークン直後の 'M' を指す
;
;   参考書籍に記載の機械語テープ形式:
;     ヘッダブロック (type=$00): name[8], fileType[1]=$02, ...
;     データブロック (type=$01) の本文を論理的に連結すると以下のセグメント列:
;       [$00][addrHi][addrLo][lenHi][lenLo] (len バイトのデータ) …繰り返し
;       [$FF][execHi][execLo]               (終端 + 実行開始アドレス)
;   セグメントの埋め込みアドレスを基準に展開する。",&Hアドレス" 指定時は先頭
;   セグメントアドレスとの差分をオフセットとして全セグメントを相対移動する。
;   ",R" 指定時はロード後に実行開始アドレス (+オフセット) へ JSR する。
;   ",R" 無しのときは BASIC へ復帰し、後続 EXEC 等が実行される。
;   X はディスパッチャ復帰用に引数末尾へ進めて返す。
;------------------------------------------------------------------------------
impl_loadm:
                JSR     play_stop               ; カセット系コマンドは演奏を中断する (参考書籍)
                JSR     skip1_sp_x
                JSR     impl_parse_fname        ; ファイル名解析 → cmt_filename, X 前進
                CLRA
                CLRB
                STD     cmt_load_ptr
                STD     mlm_offset              ; 相対オフセット = 0 (既定)
                STD     mlm_exec                ; 実行開始アドレス = 未設定 (0)
                ; 残りの作業変数初期化 (mlm_first_addr / ilm_have_addr / mlm_run)。
                ; 直後に連携サービス入口 を挟むため、当区間には 3 バイトしか置けない。
                ; 本体は別プール (空きプール) の ilm_init_tail に置く。
;------------------------------------------------------------------------------
; ilm_init_tail — LOADM の作業変数初期化の後半 (impl_loadm から JSR)。
;   impl_loadm が属する区間は連携サービス入口 を挟むため空きが 3 バイトしか
;   無い。ここへ退避して呼出 1 個に留める。D は呼出側で使わないので破壊可。
;------------------------------------------------------------------------------
ilm_init_tail:
                LDD     #$FFFF
                STD     mlm_first_addr          ; 先頭ロードアドレス = 未設定
                CLR     ilm_have_addr           ; アドレス指定有無フラグ = 0
                CLR     mlm_run                 ; ,R フラグ = 0
                ; オプション引数列 ",アドレス" および ",R" を解析
                JSR     skip_spc                ; 引数記号前の空白を除去
                BRA     ilm_opts                ; 連携サービス入口 を跨いで引数解析へ

; >>FOLD dl_seq_init
;------------------------------------------------------------------------------
; dl_seq_init — 開始クラスタからの逐次読取を初期化する。ASCII 読込と機械語
;   読込が同じ 7 命令を並べていたので 1 本にまとめた (容量捻出)。破壊: A,B (D)。
;------------------------------------------------------------------------------
dl_seq_init:
                LDA     dl_start_clu
                STA     dl_cluster              ; 現クラスタ = 開始クラスタ
                CLR     dl_nsec                 ; 残セクタ0 → 最初の要求で新クラスタを設定
                CLR     dl_clu_adv              ; 初回は開始クラスタをそのまま使う
                CLR     dl_clu_cnt              ; 鎖周回ガード初期化
                LDD     #DA_SECBUF_END
                STD     da_bptr                 ; バッファ空 (末尾) → 最初の要求で読取
                RTS
; <<FOLD dl_seq_init

ilm_opts:
                JSR     chk_comma_x     ; A=,X を読み ',' と比較 (共通化)
                BNE     ilm_args_done
                JSR     skip1_sp_x
                ; 参考書籍の LOADM 構文: 実行指定 ",R" は第2引数位置
                ; (アドレスに続く 2 個目のカンマの後) にのみ現れる。すなわち実行は
                ;   LOADM "name",アドレス,R   または   LOADM "name",,R   (アドレス省略)
                ; の「カンマ 2 個」形のみが実行指定である。1 個目のカンマの直後の
                ; 記号 (','/':'/終端) 以外は「第1引数=ロードアドレス式」として評価する
                ; ため、"LOADM "",R" のように 1 個目のカンマ直後に 'R' が来た場合も、
                ; 'R' を実行指定ではなくアドレス式 (変数 R) として評価する。
                ; (参考書籍準拠: ",R"=カンマ1個は実行指定ではない。カンマ2個の
                ;  ",,R" のみが実行指定)
                JSR     chk_comma_x     ; A=,X を読み ',' と比較 (共通化)
                BEQ     ilm_arg2                ; ",,..." → アドレス省略, 第2引数位置へ
                TSTA
                BEQ     ilm_args_done
                CMPA    #':'
                BEQ     ilm_args_done
                ; アドレス式 (ここに来る 'R' 等は変数=アドレス式として評価する)
                JSR     eval_to_addr   ; アドレスの規約 (-65536..65535)。基数付き定数は
                                       ;   符号なしなので &HE000 も 16 ビットのアドレスに収まる
                STD     cmt_load_ptr
                STD     mlm_user_addr           ; 指定アドレスを保持
                LDA     #1
                STA     ilm_have_addr
                ; 続く ",R" を確認
                JSR     chk_comma_x     ; A=,X を読み ',' と比較 (共通化)
                BNE     ilm_args_done
                LEAX    1,X
ilm_arg2:
                ; 2個目の引数位置: ',' のあとが 'R' なら実行指定
                JSR     chk_comma_x     ; A=,X を読み ',' と比較 (共通化)
                BNE     ilm_arg2_chk
                LEAX    1,X
ilm_arg2_chk:
                JSR     skip_spc                ; 2個目の ',' 後の空白を除去
                LDA     ,X
                CMPA    #'R'
                BEQ     ilm_set_run
                CMPA    #'r'
                BNE     ilm_args_done
ilm_set_run:
                LEAX    1,X                     ; 'R' を読み飛ばす
                LDA     #1
                STA     mlm_run
ilm_args_done:
                PSHS    X                       ; ディスパッチャ復帰用 X を退避
                ; --- 装置分岐 ---
                ; ファイル名解析で確定した装置 (dl_device) を判定する。ディスク指定
                ; (DL_DISK0/DL_DISK1 = bit7=1) なら、テープ待ちに入らずディスク経路
                ; (disk_loadm_body) へ分岐する。カセット (dl_device=$00) はそのまま
                ; 以下のテープ経路。オプション (,アドレス / ,,R) 解析は共通で済ませて
                ; あり、mlm_user_addr/ilm_have_addr/mlm_run/mlm_offset はディスク経路でも
                ; 尊重される。disk_loadm_body (7t_diskboot.inc) はディスク基盤
                ; (disk_dir_find/disk_read_sector) で機械語セグメント列を解析し、展開後は
                ; 本ルーチンの共通尾部 (ilm_done: オフセット/実行アドレス/,R 実行/実行アドレスワーク複写/
                ; モータ停止) へ合流する。退避済みの X も ilm_done が戻す。
                LDA     dl_device
                STA     mlm_dev                 ; 解析中も生き残る控え (dl_device は
                                                ;   テープ読取のチェックサムに潰される)
                LBMI    disk_loadm_body         ; bit7=1 (ディスク) → 別経路
                ; 偽 sync 弾きを有効化 (LOADM 実行中のみ)。1 個目 LOADM は
                ; クリーンなリーダーで無害。2 個目以降で真ヘッダ前のリーダーに
                ; 埋まる偽 $01 $3C を弾き、真ヘッダへ整列させるために使う。
                LDA     #1
                STA     cmt_strict_hdr
                ; モーター ON
                JSR     cmt_motor_on    ; モータ ON (控えも更新)
                ; ヘッダブロック待ち (ファイル名照合 + file-type=$02 確認)
ilm_header:
                LDU     #cmt_hdr_buf
                JSR     cmt_read_hdr            ; 格納は 20B まで (il_header と同じ)
                BCC     ilmh_have               ; 成功 → 内容確認へ
                TSTB                            ; 失敗: EOT (B≠0) か CRC エラー (B=0) か
                BNE     ilm_done                ; EOT (存在しない次ファイルのヘッダを
                                                ;   探し続けない) → モータ OFF で復帰。
                                                ;   常駐 ML はここへ戻り本編描画を続ける。
                BRA     ilm_header              ; CRC エラー → 再試行
ilmh_have:
                LDA     cmt_blk_type
                BNE     ilm_header              ; type≠0 → ヘッダでない
                ; ファイル名照合 (大文字小文字をそのまま比較。指定なしは無条件 =
                ; 次の ML を採用)
                JSR     cmt_name_chk
                BCS     ilm_header              ; 不一致 → 別ヘッダを探す
ilm_name_ok:
                ; ヘッダ確定 = データ読取フェーズへ。偽 sync 弾きはヘッダ探索
                ; 限定なのでここで解除する。以後のデータブロック読取は既定の動作
                ; とし、データ領域内に現れる $01 $3C 様パターンの取り扱いを一切
                ; 変えない (これを立てたままにすると一部テープの ML 本文読取を壊す)。
                CLR     cmt_strict_hdr
                ; ブロックバッファを空に初期化 (論理バイトリーダ用)
                CLR     mlm_brem
                ; セグメント列の解析開始
ilm_seg_lp:
                BSR     mlm_get_req             ; セグメント種別バイト
                CMPA    #$FF
                BEQ     ilm_term                ; $FF → 終端 (実行アドレス続く)
                TSTA
                BNE     ilm_seg_lp              ; $00 以外 → 同期外れ, 読み飛ばす
                ; 機械語テープレコードの構造 ($00 マーカ後):
                ;   [データ長 (2バイト, BE)] [ロード先アドレス (2バイト, BE)] [データ...]
                ; (参考書籍記載の機械語ファイル形式)
                ; 長さ (BE) を先に読む
                BSR     mlm_get_req
                STA     mlm_seg_len             ; lenHi
                BSR     mlm_get_req
                STA     mlm_seg_len+1           ; lenLo
                ; ロード先アドレス (BE)
                BSR     mlm_get_req
                STA     cmt_load_ptr            ; addrHi
                BSR     mlm_get_req
                STA     cmt_load_ptr+1          ; addrLo
                ; ",オフセット" 指定がある場合、参考書籍の LOADM 第2引数
                ; 仕様に従い、指定値を各セグメントの埋め込みアドレスに「加算」する
                ; (= 相対オフセット)。指定値そのものがオフセットであり、先頭
                ; セグメントアドレスとの差分ではない。
                ; 例: 埋め込み $5000 / 指定 &H100 → $5100 へ展開、実行アドレスも +$100。
                LDA     ilm_have_addr
                BEQ     ilm_seg_apply
                CMPA    #1
                BNE     ilm_seg_apply           ; 既に確定 (=2) ならスキップ
                LDD     mlm_user_addr           ; 指定値 = オフセット
                STD     mlm_offset              ; = 相対オフセット (そのまま)
                LDA     #2
                STA     ilm_have_addr           ; オフセット確定
ilm_seg_apply:
                ; 格納先 = segAddr + offset
                LDD     cmt_load_ptr
                ADDD    mlm_offset
                STD     cmt_load_ptr
                ; 先頭セグメントの最終ロードアドレスを記録 (実行アドレスワークへ複写用)。
                ; まだ未設定 ($FFFF) のときだけ保存し、以降のセグメントでは更新しない。
                LDX     mlm_first_addr
                CMPX    #$FFFF
                BNE     ilm_seg_byte
                STD     mlm_first_addr
                ; len バイトを論理バイトリーダから読んで格納
ilm_seg_byte:
                LDD     mlm_seg_len
                BEQ     ilm_seg_lp              ; len=0 → 次セグメントへ
                JSR     mlm_get_one
                BCS     ilm_done
                LDU     cmt_load_ptr
                STA     ,U+             ; 現在のメモリ構成のまま格納する
                STU     cmt_load_ptr
                LDD     mlm_seg_len
                SUBD    #1
                STD     mlm_seg_len
                BRA     ilm_seg_byte

; mlm_get_req — 論理バイトを 1 つ読む。ブロックが尽きていれば呼び出し元へは
;   戻らず ilm_done へ抜ける。同じ 2 命令の並びが読取りの各所に現れるため
;   1 本にまとめた (容量の都合。読み出す値と分岐先は変わらない)。
mlm_get_req:
                JSR     mlm_get_one
                BCC     mgr_ok
                LEAS    2,S             ; 呼び出し元の戻りアドレスを捨てる
                BRA     ilm_done
mgr_ok:
                RTS

ilm_term:
                ; 終端レコード ($FF マーカ) もセグメントと同じ並び:
                ;   [$FF] [長さ (2バイト, 常に 0)] [実行開始アドレス (2バイト, BE)]
                ; まず長さフィールド (2バイト) を読み飛ばし、続く実行アドレスを取得する。
                BSR     mlm_get_req
                BSR     mlm_get_req
                ; 実行開始アドレス (BE) を取得
                BSR     mlm_get_req
                STA     mlm_exec
                BSR     mlm_get_req
                STA     mlm_exec+1
                ; オフセット適用
                LDD     mlm_exec
                ADDD    mlm_offset
                STD     mlm_exec
ilm_done:
                ; 装置別の後始末: ディスク経路 (mlm_dev bit7=1) でだけ FDC モータを
                ; 止める。テープ経路 (mlm_dev=$00) では FDC レジスタに一切触れない
                ; (テープ経路の処理は FDC と無関係であり、常駐ローダの CMT 継続読取の
                ; 途中で装置の状態を変えないため)。
                LDA     mlm_dev
                BPL     ilmd_notdisk
                CLR     FDC_DRV                 ; FDC モータ OFF (ディスク経路のみ)
ilmd_notdisk:
                CLR     cmt_strict_hdr          ; 偽 sync 弾きを解除 (LOADM の全終端で)
                ; モータ制御 (参考書籍の LOADM 相当):
                ;   LOADM 命令の完了時にカセットモータを OFF にする。参考書籍の
                ;   F-BASIC は機械語ロードを終えるとモータを止めてから制御を戻す
                ;   (機械語起動後の実行フェーズはモータ停止状態)。
                ;   常駐型の機械語ローダ (LOADM→,R / LOADM→EXEC で起動後に残りの
                ;   テープブロックを自前ルーチンで継続読取するもの) は、後続読取の
                ;   直前に自身でモータを ON にし直す (参考書籍のモータ管理と同じ)。
                ;   そのため LOADM 終端でモータを止めても継続読取は成立する。
                ;   逆にここでモータを維持すると、一部エミュレータが「モータ ON=CMT
                ;   ターボ」で本体クロックを加速するため、機械語ソフト実行中も加速
                ;   された状態になってしまう (実機は等速)。等速化のためここで止める。
                ;   機械語を 1 バイトもロードできなかった場合 (mlm_first_addr=$FFFF、
                ;   エラー/EOF 等) も同様にモータ OFF で BASIC へ戻る (ild_no_ml)。
                JSR     cmt_motor_off           ; モータ OFF (公開仕様 LOADM 相当)
                ; 直近の LOADM の入口アドレスを EXEC アドレス (EXEC_ADDR $0217) に
                ; 残す。参考書籍の EXEC は「開始アドレスの指定がないときは
                ; 直前に実行した LOADM の入口アドレスから実行する」と定める。入口はファイル
                ; の実行開始アドレス、それが無ければ先頭のロードアドレス。
                ; 1 バイトもロードしていない ($FFFF) ときは書かない。
                LDD     mlm_first_addr
                CMPD    #$FFFF
                BEQ     ild_no_ml               ; ML 未ロード → モータ OFF して復帰
                LDD     mlm_exec
                BNE     ilm_set_exec
                LDD     mlm_first_addr
ilm_set_exec:
                STD     EXEC_ADDR
                PULS    X                       ; ディスパッチャ復帰用 X
                ; ,R 指定なら実行アドレスへ JSR (モータは OFF 済み)
                LDA     mlm_run
                BEQ     ilm_ret                 ; ,R 無し → BASIC へ復帰
                LDD     mlm_exec
                PSHS    X
                TFR     D,X
                ; 入口アドレスへそのまま JSR する。参考書籍の LOADM は
                ; 「R の指定があると、プログラムをメモリにロードした後、入口から実行を
                ; 始めます」とだけ定め、メモリ構成の切換えにも入口アドレスの範囲にも
                ; 触れていない。ROM / RAM モードの切換えは、
                ; 参考書籍が $FD0F の読み書きで行うハードウェアの機能として
                ; 定めるものである。EXEC と同じ扱いにする。
                JSR     ,X                      ; ML エントリへ
                PULS    X
ilm_ret:
                ; モータは ilm_done 冒頭で OFF 済み。常駐ローダは後続読取の直前に
                ; 自前でモータを ON にし直す (参考書籍のモータ管理と同じ)。
                ANDCC   #$FE
                RTS
ild_no_ml:
                ; 機械語を 1 バイトもロードできなかった → CMT モータ OFF して復帰
                ; (ディスク経路で来た場合、FDC モータは ilm_done で既に停止済み)
                PULS    X                       ; ディスパッチャ復帰用 X
                JSR     cmt_motor_off
                ANDCC   #$FE
                RTS

;------------------------------------------------------------------------------
; mlm_get_byte: ML データブロック列から論理 1 バイトを取り出す
;   ブロックバッファ (MLBUF = 参考書籍「CAS0 入出力バッファ」) が
;   空なら次のデータブロック (種別 01) を読み込む。
;   type=$02/$FF/その他 (=データ終端) に達したらキャリーセットで返す。
;   出力: A = バイト, キャリー=0 成功 / キャリー=1 終端
;   破壊: A,B,X,U (cmt_read_block 経由)。mlm_seg_len 等は保存。
;------------------------------------------------------------------------------
mlm_get_byte:
                LDA     mlm_brem
                BNE     mgb_serve               ; バッファに残りあり
                ; 次のデータブロックを読む
mgb_fill:
                LDU     #MLBUF
                JSR     cmt_read_block
                BCC     mgb_have                ; 成功 → タイプ確認へ
                TSTB                            ; 失敗: EOT (B≠0) か CRC エラー (B=0) か
                BNE     mgb_eof                 ; EOT → データ終端扱い (無限再試行しない)
                BRA     mgb_fill                ; CRC エラー → 再試行
mgb_have:
                LDA     cmt_blk_type
                CMPA    #1
                BNE     mgb_eof                 ; type≠1 → データ終端
                LDA     cmt_blk_len
                BEQ     mgb_fill                ; 長さ0 → 次ブロック
                STA     mlm_brem
                LDD     #MLBUF
                STD     mlm_bptr
mgb_serve:
                LDU     mlm_bptr
                LDA     ,U+
                STU     mlm_bptr
                DEC     mlm_brem
                ANDCC   #$FE                    ; キャリークリア = 成功
                RTS
mgb_eof:
                ORCC    #$01                    ; キャリーセット = 終端
                RTS


; ramstub_ifc ($01B5-) は mlm_install_ramstub がその場で組み立てる。未設定の EXEC
;   アドレス / USR アドレスの飛び先で、参考書籍
;   は未設定値を「Illegal Function Call のアドレス」と定める。当方は ROM 内の
;   誤り送出のアドレスを固定しないので、低位 RAM のここで中継し、$0217 / $0219- に
;   入る値を動かない位置に保つ。

; (il_relink — 中間コードイメージの再リンク — は、中間コード形式の受理廃止に
;  伴い撤去した)



; firq_read — $FD04 (参考書籍の FIRQ フラグ) を読む唯一の窓口。
;   同レジスタは ATTENTION (bit0) と中断キー (bit1) の 2 要因を 1 つのリード
;   専用フラグに載せており、「0=割込みあり」の表示は一度読むと落ちる。
;   中断キーの検査だけを見て読み捨てると、同時に載っていた ATTENTION
;   (参考書籍: インターバルタイマ・クロック・PF キーが要因) が消えてしまい、
;   機能キーの発生を取り逃がす。よって読むのはここだけとし、ATTENTION は
;   控え (key_attn) へ積んでから呼出元へ値を返す。控えを消費するのは
;   key_attn_poll (共有 RAM を触れる安全な場所)。
;   出力: A = $FD04 の値。破壊: A, CC (B/X/Y/U は保つ)。
;   中断キーの押下も同じ理由でここだけが見る。押下は BREAK フラグ (BRK_FLAG
;   $0313。参考書籍「BREAK フラグ」) へ非 0 で控え、判定側
;   (brk_gate / brk_active) はレジスタではなく控えを見る。$FD04 は一度読むと
;   落ちるため、判定を伴わない読取 (key_attn_poll) が押下を取りこぼさない。
;   出力: A = $FD04 の値を反転したもの (1 = 発生)。破壊: A, CC (B/X/Y/U は保つ)。
firq_read:
                LDA     >PORT_FIRQ      ; $FD04 (bit0 = ATTENTION, bit1 = 中断キー)
                COMA                    ; 「0=発生」を「1=発生」へ
                BITA    #$02
                BEQ     fqr_nobrk       ; 中断キーは押されていない
                STA     >BRK_FLAG       ; 押下を控えへ (bit1 が立つので必ず非 0)
fqr_nobrk:
                BITA    #$01
                BEQ     fqr_rts         ; ATTENTION は載っていない
                INC     >key_attn       ; 受領を控えへ (0 以外 = 未消費の発生あり)
fqr_rts:
                RTS

; firq_isr — FIRQ の受け口。割込フックスロットの FIRQ 欄 ($01E0) から JMP で入る。
;   FIRQ の要因は ATTENTION (サブシステムからの通知) と中断キーの 2 つで、
;   どちらも $FD04 を読むまで要求線が下りない (参考書籍、
;   および 参考書籍)。ここでは要因を控えへ積むだけで、
;   分岐は文の切れ目 (key_attn_poll / brk_gate) が行う。
;   FIRQ は CC と PC しか積まない (E=0) ので、使うレジスタは自分で積む。
firq_isr:
                PSHS    A
                JSR     firq_read       ; $FD04 を読んで要因を控えへ (要求線が下りる)
                PULS    A
                RTI

brk_gate:
                BSR     firq_read       ; $FD04 を読んで押下を BRK_FLAG へ
                TST     >BRK_FLAG
                BEQ     bg_pass         ; 非押下 → 本来の処理へ
brk_stop:
                CLR     >BRK_FLAG       ; 押下を受け付けた
                CLRA
                TFR     A,DP            ; 直接ページを既定 (0) へ戻す
                                        ;   (テープ計測の途中から来る経路があるため)
                JSR     cmt_motor_off   ; カセットのモータ停止
                LDX     CURIP           ; 停止位置 = これから実行する文の先頭
                JMP     impl_stop       ; "Break In <行>" + 再開位置の記録
bg_pass:
                JMP     str_tmp_clear   ; 文の切れ目の一時文字列開放 (末尾呼び)


;==============================================================================
; clear_body — CLEAR [文字列領域サイズ][,最上位アドレス] の本体
;   (連携サービス入口の impl_clear から JMP。当区間に残量が無いため本プール)
;
;   参考書籍「CLEAR 文」: 全変数を消去し、文字列領域の大きさと、
;   BASIC が使う最上位アドレスを指定する。プログラム本体 (TXTTAB..VARTAB) は残る。
;
;   要求された大きさを確保できるかを、変数を消す前に検査する。
;     ・第1引数 n は「整数を要求する文脈」の規約 (最近接丸め、整数の範囲外は
;       Overflow)。負値は Illegal Function Call。
;     ・第2引数 m は「アドレスを要求する文脈」の規約 (ゼロ方向切り捨て、
;       -65536..65535 の外は Illegal Function Call)。16 ビットで見て $8000 以上
;       (物理 RAM 上端 STACK_TOP=$7FFF 超) は Out Of Memory。
;     ・確保可否: 新しい文字列領域の下限 (新 MEMTOP − n) の下へ、いま使っている
;       システムスタック (枠列を含む) をそのまま移したときの S − STK_RESERVE が
;       VARTAB 以上であること。足りなければ Out Of Memory。
;       VARTAB はプログラム末尾 = 変数領域の先頭で、CLEAR は変数を消すので
;       ここが「下限が侵してはならない境界」になる。
;     検査を欠くと、確保できない大きさを黙って受理して文字列領域の下限を
;       プログラム本体まで下げ、システムスタックの移設で本文を潰す。
;     誤りにするときは何も書き換えない (変数・配列・MEMTOP・文字列領域は
;       そのまま)。検査を全て通してから破壊を始める順序にしてある。
;   枠 (CPU スタック): 0,S = 文字列領域の大きさ / 2,S = 新しい MEMTOP
;==============================================================================
impl_clear:
clear_body:
                LDD     MEMTOP
                PSHS    D               ; 2,S:3,S = 新しい MEMTOP (暫定 = 現状維持)
                SUBD    STRBOT
                PSHS    D               ; 0,S:1,S = 現在の文字列領域の大きさ
                JSR     skip_sp_tst     ; 空白飛ばし + A の 0 判定 (共通化)
                BEQ     ic_init         ; 引数なし → 文字領域と上限アドレスを初期設定
                CMPA    #':'
                BEQ     ic_init
                CMPA    #','            ; 第1引数省略で ",m" だけの形
                BEQ     ic_arg2
                ; 第1引数 (文字列領域の大きさ)
                JSR     eval_to_int     ; 整数の規約 (範囲外は Overflow)
                TSTA
                BMI     ic_err5         ; 負の大きさ → Illegal Function Call
                STD     ,S              ; 大きさを差し替え
                JSR     skip_sp_tst     ; 空白飛ばし + A の 0 判定 (共通化)
                CMPA    #','
                BNE     ic_fin
ic_arg2:
                JSR     skip1_sp_x              ; 空白読み飛ばし (1 進めてから)
                LDA     ,X
                BEQ     ic_fin          ; ",m" 省略 → 何もしない
                CMPA    #':'
                BEQ     ic_fin
                ; 第2引数 (最上位使用アドレス m)
                ;   一旦 CLEAR ,&H1FFF で縮めてから CLEAR n,&H3FFF で上げ直す
                ;   ローダの慣用句が効くよう、拡大も許可する (上限は物理 RAM 上端)。
                JSR     eval_to_addr    ; アドレスの規約 (-65536..65535、外は誤り 5)
                CMPA    #$80            ; A>=$80 ⇔ 16 ビットで見て $8000 以上
                BHS     ic_err7         ; 物理 RAM 上端超 → Out Of Memory
                SUBD    #1
                STD     2,S             ; 新しい BASIC 使用上限 −1 (= m−1。
                                        ;   参考書籍「BASIC 使用上限−1」)
                BRA     ic_fin
ic_init:
                ; 引数を省いた CLEAR は文字領域と BASIC の使用する上限アドレスを
                ;   初期設定する (参考書籍「CLEAR 文」の例: 「CLEAR … 文字領域、
                ;   BASIC の使用する上限アドレスは初期設定されます」)。初期値は
                ;   起動時と同じ 上限 −1 = STACK_TOP−1、文字領域 = 300 byte (同節
                ;   「BASIC の起動時、文字領域の大きさは 300 バイトに初期設定されて
                ;   います」)。確保可否の検査と実際の張り直しは以降の共通路が行う。
                LDD     #STACK_TOP-1
                STD     2,S
                LDD     #STRSPC_DEF
                STD     ,S
ic_fin:
                ; --- 確保できるか: 移設後のシステム S − STK_RESERVE >= VARTAB か ---
                LDD     2,S
                SUBD    ,S              ; 新しい文字列領域の下限
                BLO     ic_err7         ; 桁借り = 下限が 0 を割る
                PSHS    D               ; 0,S = 新しい下限 (一時)
                TFR     S,D             ; 現在の S (枠列と呼出フレームを含む使用中の範囲)
                ADDD    ,S              ; + 新しい下限 (和は $10000 を越えない)
                SUBD    STRBOT          ; − 旧下限 = 移設後の S
                BLO     ic_err7         ; 使用中の範囲が新しい下限より大きい
                SUBD    #STK_RESERVE
                BLO     ic_err7
                CMPD    VARTAB
                BLO     ic_err7         ; 変数領域の先頭を侵す → Out Of Memory
                LEAS    2,S             ; 一時を捨てる
                ; --- ここから確定。破壊を始める ---
                LDD     2,S
                STD     MEMTOP          ; 新しい BASIC 使用上限
                ; 変数/配列領域を開放 (ARYTAB=STREND=VARTAB = 変数なし)
                JSR     vars_clear_all
                PULS    D               ; D = 文字列領域の大きさ
                LEAS    2,S             ; 新 MEMTOP の枠は用済み
                ; clear_relocate_stack は作業で X を破壊する。X は呼び出し元
                ; (impl_exec_prog / cmd_direct) が続行位置として使う BASIC
                ; 命令ポインタなので、退避してから移設し復元する。退避値は移設
                ; 対象スタック領域に乗るため、移設後の新スタックから正しく取り出せる。
                PSHS    X               ; CURIP (命令ポインタ) を退避
                JSR     ic_setbot       ; 下限確定 + 必要なら移設 + 領域初期化
                PULS    X               ; 移設後スタックから CURIP を復元
                ; X (実行中の文の位置) は実行用行バッファ (固定) の中なので補正不要。
                ; CLEAR の後始末 (捕捉先の解除 + 再開位置の破棄) は
                ; 当区間に余白が無いためプール側 (ic_finish) が受け持つ。
;------------------------------------------------------------------------------
; ic_finish — CLEAR の後始末 (clear_body から末尾呼び)。
;   ・誤りの捕捉先を解除する。CLEAR はすべての変数を初期状態に戻す
;     (参考書籍) ので、変数が生きている前提で書かれた捕捉先へ
;     その後の誤りを送ってはならない。
;   ・CONT の再開位置も破棄する (変数を消した以上、停止位置から続けても
;     実行文脈が揃わない)。
;   clear_body の属する区間に余白が無いため、本体をこのプールに置く。
;------------------------------------------------------------------------------
ic_finish:
                CLR     ONERROR_EN
                JMP     cont_clear
ic_err5:
                JMP     errc_5          ; 積んだ枠の始末は実行ループの巻戻しに委ねる
ic_err7:
                JMP     err_rg          ; Out Of Memory (同上)




