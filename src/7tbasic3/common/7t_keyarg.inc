;==============================================================================
; KEY 文の引数前処理
;
;   参考書籍「KEY 文」の書式は
;       KEY 番号,"文字列"        (番号 = 1〜10。範囲外は Illegal Function Call)
;       KEY LIST                 (割当て内容の一覧表示)
;   である。`KEY ON` / `KEY OFF` のように番号の位置へその他の予約語が来る形は
;   受け付けず、構文エラーとする (動作観察に基づく)。
;   `KEY LIST` は PF1〜PF10 の割当て一覧を表示する。表示本体は impl_key_list
;   (7t_statements.inc) にあり、ここから直接ジャンプする。impl_key_list は
;   C=1 で戻るため、呼出元 impl_key は「割当てではない」と判定して復帰する。
;
;   ikey_parse_num:
;     入力: X = KEY 命令語の直後
;     出力: C=0 → B = キー番号, X = ',' の直後 (= 文字列の先頭)
;           C=1 → KEY LIST (一覧表示済み。呼出元は何もせず戻る)
;     不正形は Syntax Error を通知して呼出元へ復帰しない。
;
;   配置: impl_key の直近は後続の空きまでの余白が
;     4 バイトしかないため、本前処理は別の空きプールへ置く。
;     impl_key からは JSR 一本で呼ぶだけなので位置依存は無い。
;==============================================================================
ikey_parse_num:
                JSR     skip_sp_x       ; 命令語直後の空白を読み飛ばす
                JSR     ikey_isnum      ; C=1 → 数値式として評価してよい (単項符号を含む)
                BCS     ikey_num
                CMPA    #TOK_LIST       ; LIST トークン
                BNE     ikey_syn        ; その他の予約語 (ON/OFF 等) → 構文エラー
                LEAX    1,X             ; LIST を消費
                JMP     impl_key_list   ; 一覧表示 (C=1 を立てて impl_key へ戻る)
ikey_num:
                JSR     eval_to_int_key ; 整数化 + 値域 1..10 (外は Illegal Function Call)
                LDA     ,X+             ; ',' 必須
                CMPA    #','
                BNE     ikey_syn
                ANDCC   #$FE            ; C=0 = 通常の割当て
                RTS
ikey_syn:
                JMP     errc_2

;==============================================================================
; ikey_str — KEY 文の第 2 引数 (割当て文字列) を取り込む。
;
;   参考書籍「KEY 文」の第 2 引数は文字列式である。文字列定数だけを
;   その場で読み取る作りだと `KEY 1,A$` / `KEY 1,"A"+CHR$(13)` / `KEY 1,MID$(...)`
;   が一切通らないので、汎用の文字列式評価 (sym_eval_str) へ通す。
;   結果は sym_buf に置かれ、呼出元 impl_key がそこから割当ての枠へ複写する。
;
;   入力: X = ',' の直後 (文字列式の先頭)
;   出力: B = 文字数 (0..15), sym_buf[0..B-1] に本体, X = 式の直後
;         文字列でなければ Type Mismatch を通知して呼出元へ復帰しない。
;
;   長さの上限が 15 なのは、割当ての枠が 1 キー 16 byte で、先頭の 1 byte を
;   長さと制御ビットが占めるためである。上限を超えた入力は切り詰める。
;   上限を掛けずに渡すと、枠を越えた複写が隣のキー番号の割当てを塗り潰し、
;   別のキーを打った利用者に無関係な文字列が現れる。
;==============================================================================
ikey_str:
                JSR     sym_eval_str    ; C=0: B=文字数/sym_buf, C=1: 非文字列
                LBCS    err_tmm         ; 数値式などは Type Mismatch
                CMPB    #15             ; 割当ての枠に入る最大文字数
                BLS     iks_done
                LDB     #15             ; 超過分は切り捨てる
iks_done:
                RTS

;==============================================================================
; cont_save — CONT 用に停止位置を記録する。STOP / END / 捕捉されないエラーの
;   表示尾部 (ieh_tail) から呼ぶ共通ルーチン。
;   入力: X = 再開位置 (停止した文の「次の位置」。エラー時は文の先頭)
;   出力: D = 記録前の CURLIN。直接モード ($FFFF) なら記録せずそのまま返す
;         ので、直接入力の STOP はプログラムの再開位置を壊さないし
;         "Break" に行番号も付かない。
;   後半 (cs_do) は空きプールにある (単一プールに収まらないため)。
;==============================================================================
cont_save:
                LDD     CURLIN
                CMPD    #$FFFF
                LBNE    cs_do           ; プログラム実行中のみ記録する
                RTS
