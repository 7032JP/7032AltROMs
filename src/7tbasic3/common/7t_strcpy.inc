; 文字列領域 — 実体の複写
;==============================================================================
;------------------------------------------------------------------------------
; str_cpy_in — X の指す先へ STRPTR から STRLEN バイト複写する。X/U は保存する。
;   一時への複写 (str_to_tmp) と恒久ブロックへの複写 (str_own) が共用する。
;   破壊: A,B。
;------------------------------------------------------------------------------
str_cpy_in:
                PSHS    U,X
                LDB     STRLEN
                BEQ     scp_done
                ; 末尾から写す。恒久ブロックへ写すときは、確保が「返した
                ;   ばかりの一時」の上に重なることがあり (str_perm_alloc の
                ;   一時返却)、そのとき書込先は読出元と同じか上位になる。
                ;   先頭から写すと書いたばかりのバイトを読み直して内容が崩れる。
                CLRA                    ; D = 長さ (B は以降も長さのまま)
                LDU     STRPTR
                LEAU    D,U             ; U = 読出元の末尾 + 1
                ABX                     ; X = 書込先の末尾 + 1
scp_lp:
                LDA     ,-U
                STA     ,-X
                DECB
                BNE     scp_lp
scp_done:
                PULS    X,U,PC
