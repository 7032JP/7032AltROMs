0 REM AltROMs test (MIT)
1 REM 同じ優先順位の演算子は左から順に評価する: AND を 2 つ以上つないだ式。
10 ON ERROR GOTO 900
20 X=2:Y=1:Z=3:A=7:B=5:C=3
30 IF X=2 AND Y>0 AND Z=3 THEN PRINT "A30 ";
40 IF X=2 AND Y>0 THEN PRINT "A40 ";
50 PRINT "P50=";1 AND 1 AND 1;
60 PRINT "P60=";A AND B AND C;
70 PRINT "P70=";15 AND 7 AND 3 AND 1;
80 Q=7 AND 6 AND 4:PRINT "P80=";Q;
90 PRINT "P90=";(7 AND 6) AND 4;
100 PRINT "P100=";1 OR 2 OR 4;
110 PRINT "P110=";7 AND 3 OR 4 AND 5;
120 PRINT "END"
130 END
900 PRINT "E";ERL;ERR;:RESUME NEXT
