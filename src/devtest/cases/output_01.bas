0 REM AltROMs test - MIT, own work.
1 REM OUTPUT (20) は RCBLNH を 16 ビットの文字数として扱い、上限を置かない。
2 REM 123 / 124 バイトの文字列 (位置指定 $12 X Y を 120 バイト目の前後に置く) と
3 REM 280 バイトの文字列を出し、画面の並びとエラーステータス・キャリーを見る。
5 CLS
10 FOR I=0 TO 14:READ B:POKE &H6000+I,B:NEXT
20 POKE &H6100,20:POKE &H6102,&H62:POKE &H6103,0:A=&H6200
30 POKE A,&H12:POKE A+1,0:POKE A+2,0:FOR I=3 TO 117:POKE A+I,67:NEXT
40 POKE A+118,&H12:POKE A+119,10:POKE A+120,3:POKE A+121,88:POKE A+122,89:L=123:GOSUB 900:S1=S:C1=C
50 POKE A,&H12:POKE A+1,0:POKE A+2,4:FOR I=3 TO 118:POKE A+I,68:NEXT
60 POKE A+119,&H12:POKE A+120,10:POKE A+121,7:POKE A+122,88:POKE A+123,89:L=124:GOSUB 900:S2=S:C2=C
70 PRINT
80 FOR I=0 TO 279:POKE A+I,48+I MOD 10:NEXT:L=280:GOSUB 900:S3=S:C3=C
90 PRINT "S";S1;S2;S3;"C";C1;C2;C3
100 END
900 POKE &H6104,L\256:POKE &H6105,L MOD 256:POKE &H6101,255:EXEC &H6000:S=PEEK(&H6101):C=PEEK(&H6120):RETURN
1000 DATA 142,97,0,173,159,251,250,31,168,132,1,183,97,32,57
