0 REM AltROMs test - MIT, own work.
1 REM GET@/PUT@ 形式3/4 (書式指定子 G つき): 図形を配列へ取り込み、画面を消して
2 REM から別の位置へ戻すと、元の画素が復元される。POINT (真=-1/偽=0) で確認する。
10 CLS
20 DIM P%(100)
30 LINE(0,180)-(15,180),PSET
40 LINE(0,187)-(15,187),PSET
50 GET@(0,180)-(15,187),P%,G
60 CLS
70 PUT@(32,180)-(47,187),P%,PSET
80 A=POINT(32,180):B=POINT(47,180):C=POINT(32,187):D=POINT(40,183)
90 CLS
100 LINE(0,180)-(15,180),PSET,2
110 GET@A(0,180)-(15,187),P%,G
120 CLS
130 PUT@A(64,180)-(79,187),P%,PSET
140 COLOR 2:E=POINT(64,180):F=POINT(79,180):G1=POINT(64,181):COLOR 7
150 CLS
160 PRINT A;B;C;D
170 PRINT E;F;G1
