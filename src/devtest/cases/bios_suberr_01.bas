0 REM AltROMs test - MIT, own work.
1 REM 機械語 I/O サービスは、サブシステムが返したエラーコード (60〜70) を
2 REM エラーステータス (制御ブロック +1) に返し、エラーのときキャリーを 1 にする。
3 REM SUBIN (17) に一覧に無いコマンド &H50 を送る (70 = コマンドコードの誤り)、
4 REM SUBIN に INKEY (&H29) を送り直す (正常 = 0。SUBIN はデータバイト数を入力バイト数に
5 REM 書き換えるので、送る前に戻す)、
6 REM OUTPUT (20) に位置指定 &H12 0 99 (行が範囲外。61 = コンソール座標値の誤り) を送り、
7 REM ステータスとキャリーを見る。
10 FOR I=0 TO 14:READ B:POKE &H6000+I,B:NEXT
20 POKE &H6102,&H61:POKE &H6103,&H10
30 POKE &H6100,17:POKE &H6104,0:POKE &H6105,4:POKE &H6106,0:POKE &H6107,1
40 POKE &H6110,0:POKE &H6111,0:POKE &H6112,&H50:POKE &H6113,0:GOSUB 900:S1=S:C1=C
50 POKE &H6105,4:POKE &H6107,5:POKE &H6110,0:POKE &H6112,&H29:GOSUB 900:S2=S:C2=C
60 POKE &H6100,20:POKE &H6105,3:POKE &H6110,&H12:POKE &H6111,0:POKE &H6112,99:GOSUB 900:S3=S:C3=C
70 PRINT "S";S1;S2;S3;"C";C1;C2;C3
80 END
900 POKE &H6101,255:EXEC &H6000:S=PEEK(&H6101):C=PEEK(&H6120):RETURN
1000 DATA 142,97,0,173,159,251,250,31,168,132,1,183,97,32,57
